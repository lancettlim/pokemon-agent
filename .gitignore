# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/

# dbt
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/data/*.duckdb
dbt/data/*.duckdb.wal
dbt/.user.yml

# Generated validation reports (template stays tracked)
reports/validation/validation_report.json
!reports/validation/validation_report.template.json

# dbt build outputs: regenerated by `dbt build` every run, never need committing
data/normalized/*.csv
data/marts/*.csv

# Raw source snapshots: regenerable via `python -m pipelines.cli extract
# <source>` (pokeapi | opgg | munchstats | pokebase | bulbagarden | all).
# Written date-partitioned, one CSV per source per UTC day, under
# data/staging/<source>/<date>.csv (backlog.md #1) and pruned to a bounded
# number of snapshots per source (see pipelines/cli.py's _RETENTION_COUNTS)
# rather than a single overwritten file. They grow/change on every refresh
# per dataset-spec.md's refresh policy (daily for OP.GG/MunchStats, weekly
# for PokéAPI) and a single munchstats snapshot alone is already ~37MB, so
# they're not committed — unlike data/normalized/, schema contracts for
# these live in data/staging/*.schema.json (tracked) rather than in the
# data itself.
data/staging/*/*.csv

# Downloaded sprite/icon image cache: regenerable via `python -m
# pipelines.cli extract bulbagarden` (Bulbagarden sprites) and
# pipelines/render/assets.py (PokéAPI-sprites type/item icons, fetched
# on-demand by the renderer). Not committed for the same reason as
# data/staging/ — regenerable build output, not a deliverable.
data/assets/

# Release packages from 0.4.0 on are GitHub Release assets, not commits
# (docs/upgrade-plan-2027q1.md, D1; .github/workflows/cut-release.yml).
# The three versions published before that stay tracked.
/releases/data/*
!/releases/data/README.md
!/releases/data/0.1.0/
!/releases/data/0.2.0/
!/releases/data/0.3.0/
/releases/packages/

# Claude Code hook state (.claude/hooks/artifact_republish.py)
/.claude/state/
