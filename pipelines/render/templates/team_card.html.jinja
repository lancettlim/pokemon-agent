<!doctype html>
<html>
<head>
<meta charset="utf-8">
<style>
  /* Broadcast/esports theme (docs/design-system.md's broadcast palette) —
     bold red/gold color-blocking, mirroring the dashboard's own
     broadcast re-theme so the two pipelines read as one visual family. */
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: "Helvetica Neue", Arial, sans-serif;
    background: #10161f;
    padding: 20px;
  }
  .card-wrap {
    width: 1160px;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0,0,0,0.35);
  }
  .banner {
    background: #e3323c;
    color: #ffffff;
    text-align: center;
    padding: 14px 20px;
    font-size: 30px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    border-bottom: 3px solid #b8262e;
  }
  .banner .subtitle {
    display: block;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 1px;
    color: #ffe1e3;
    text-transform: none;
    margin-top: 2px;
  }
  .player-row {
    background: #12131a;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 8px 20px;
    font-size: 15px;
    font-weight: 700;
  }
  .player-row .country {
    background: #f4b942;
    color: #4a3300;
    border-radius: 999px;
    padding: 1px 10px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.5px;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    background: #f4b942;
    padding: 6px;
  }
  .slot {
    background: #fde9b8;
    border-radius: 4px;
    display: grid;
    grid-template-columns: 1fr 124px;
    overflow: hidden;
  }
  .slot .body {
    padding: 10px 12px;
  }
  .slot-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
  }
  .slot-header .name {
    font-size: 17px;
    font-weight: 800;
    color: #7a2e00;
    letter-spacing: 0.5px;
  }
  .pill-row {
    display: flex;
    gap: 6px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }
  .pill {
    display: flex;
    align-items: center;
    gap: 5px;
    background: #e3323c;
    border-radius: 999px;
    padding: 3px 10px 3px 6px;
    font-size: 12px;
    font-weight: 700;
    color: #ffffff;
  }
  .pill img { width: 18px; height: 18px; }
  .pill.tera { background: #12131a; color: #f4b942; }
  .move-list { display: flex; flex-direction: column; gap: 3px; }
  .move-row {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #ffffff;
    border-radius: 3px;
    padding: 3px 8px;
    font-size: 12px;
    font-weight: 600;
    color: #16324f;
  }
  .move-row .type-dot {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .move-row .type-dot img { width: 14px; height: 14px; }
  /* V6's square type badge, the same markup the dashboard draws. */
  .type-sq { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 4px; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.14); }
  .type-sq svg { filter: drop-shadow(0 0 1px rgba(0,0,0,0.45)); }
  .sprite-cell {
    position: relative;
    background: #fbd889;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* The team strip's badges (docs/upgrade-plan-2027q2.md, V3): the held
     item in a white circle at the top-right, a Mega badge under it. */
  .sprite-cell .item-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 4px rgba(0,0,0,0.35);
  }
  .sprite-cell .item-badge img { width: 28px; height: 28px; image-rendering: auto; }
  .sprite-cell .mega-badge {
    position: absolute;
    top: 46px;
    right: 10px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: conic-gradient(#e3323c, #f2c230, #2e9a4f, #2b6fd6, #e3323c);
    color: #fff;
    font-size: 15px;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    text-shadow: 0 0 3px rgba(0,0,0,0.7);
    box-shadow: 0 1px 4px rgba(0,0,0,0.35);
  }
  .sprite-cell img { width: 104px; height: 104px; image-rendering: pixelated; }
  .sprite-cell .placeholder {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    background: #e3b563;
  }
</style>
</head>
<body>
  <div class="card-wrap">
    <div class="banner">
      {{ card.team_name }}
      {% if card.subtitle %}<span class="subtitle">{{ card.subtitle }}</span>{% endif %}
    </div>
    {% if card.player_name or card.country %}
    <div class="player-row">
      {% if card.player_name %}<span>{{ card.player_name }}</span>{% endif %}
      {% if card.country %}<span class="country">{{ card.country }}</span>{% endif %}
    </div>
    {% endif %}
    <div class="grid">
      {% for slot in card.slots %}
      <div class="slot">
        <div class="body">
          <div class="slot-header">
            <span class="name">{{ slot.pokemon_name }}</span>
          </div>
          <div class="pill-row">
            {% if slot.ability %}<div class="pill">{{ slot.ability }}</div>{% endif %}
            {% if slot.nature %}<div class="pill">{{ slot.nature }}</div>{% endif %}
            {% if slot.item_name %}
            <div class="pill">
              {% if slot.item_icon_path %}<img src="{{ slot.item_icon_path | data_uri }}">{% endif %}
              {{ slot.item_name }}
            </div>
            {% endif %}
            {% if slot.tera_type %}<div class="pill tera">Tera {{ slot.tera_type }}</div>{% endif %}
          </div>
          <div class="move-list">
            {% for move in slot.moves %}
            {% set mt = slot.move_types[loop.index0] %}
            <div class="move-row">
              {% if mt and square_badge(mt, 20) %}{{ square_badge(mt, 20) }}{% else %}
              <span class="type-dot" style="background: {{ mt | type_color }};">
                {% if mt and type_icons.get(mt.lower()) %}<img src="{{ type_icons.get(mt.lower()) }}">{% endif %}
              </span>{% endif %}
              {{ move }}
            </div>
            {% endfor %}
          </div>
        </div>
        <div class="sprite-cell">
          {% if slot.sprite_path %}
            <img src="{{ slot.sprite_path | data_uri }}">
          {% else %}
            <div class="placeholder"></div>
          {% endif %}
          {% if slot.item_name and slot.item_icon_path %}<span class="item-badge"><img src="{{ slot.item_icon_path | data_uri }}" alt=""></span>{% endif %}
          {% if "mega" in (slot.form_name or "").split("-") %}<span class="mega-badge">M</span>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</body>
</html>
