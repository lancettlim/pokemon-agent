<!doctype html>
<html>
<head>
<meta charset="utf-8">
<style>
  /* Top 12 share card (docs/upgrade-plan-2027q2.md, V8), the Overview's
     board as an image: 16:9 (1920x1080) lays out like the desktop board,
     six tiles, the band, six more; 4:5 (1080x1350) and 9:16 (1080x1920)
     use the phone board, band on top and three columns, not a squeezed
     16:9. Colours are the board's tokens (docs/design-system.md, V7). */
  @font-face {
    font-family: "Board Display";
    src: url("{{ font_uri }}") format("woff2");
    font-weight: 200 700;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: "Helvetica Neue", Arial, sans-serif; background: #10161f; }
  .card-wrap {
    display: flex; flex-direction: column;
    background-color: #ea0028;
    background-image:
      radial-gradient(#84010c 1.6px, transparent 2.2px),
      repeating-linear-gradient(135deg, transparent 0 40px, rgba(0, 0, 0, 0.1) 40px 52px);
    background-size: 16px 16px, auto;
    color: #12131a;
  }
  .landscape { width: 1920px; height: 1080px; padding: 34px; }
  .portrait { width: 1080px; height: 1350px; padding: 28px; }
  .story { width: 1080px; height: 1920px; padding: 36px; }
  .surface { flex: 1; display: flex; flex-direction: column; background: #fff; border-radius: 22px; padding: 26px 28px 18px; min-height: 0; }
  .grid { flex: 1; display: grid; min-height: 0; }
  /* Hero art breaks each tile's top edge by a quarter of its width, so a
     tile row sits that far below whatever is above it. */
  .landscape .grid { grid-template-columns: repeat(6, 1fr); grid-template-rows: 1fr auto 1fr; gap: 80px 20px; padding-top: 72px; }
  .portrait .grid, .story .grid { grid-template-columns: repeat(3, 1fr); grid-template-rows: auto repeat(4, 1fr); gap: 92px 18px; }
  .band { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .landscape .band { grid-column: 1 / -1; grid-row: 2; }
  .portrait .band, .story .band { grid-column: 1 / -1; grid-template-columns: 1fr 1fr; gap: 16px; }
  .portrait .band .scope, .story .band .scope { grid-column: 1 / -1; }
  .block { border-radius: 14px; padding: 18px 24px; display: flex; flex-direction: column; justify-content: center; gap: 6px; min-height: 120px; }
  .title {
    color: #fff;
    background-color: #12131a;
    background-image:
      linear-gradient(115deg, transparent 0 66%, #ea0028 66% 71%, transparent 71% 75%, #ffc549 75% 77%, transparent 77%),
      radial-gradient(rgba(255, 255, 255, 0.09) 1.4px, transparent 1.9px);
    background-size: auto, 10px 10px;
  }
  .display { font-family: "Board Display", "Arial Narrow", sans-serif; font-weight: 700; text-transform: uppercase; line-height: 1; }
  .title h1 { font-size: 64px; }
  .title p { font-size: 22px; color: #d7dbe8; }
  .mark { background: #ffc549; }
  .mark strong { font-size: 56px; }
  .mark span { font-size: 24px; font-weight: 700; }
  .scope { background: #7f2629; color: #fff; align-items: flex-start; }
  .chip { display: inline-block; padding: 6px 16px; border-radius: 6px; background: #12131a; font-size: 24px; font-weight: 800; font-style: italic; letter-spacing: 0.06em; text-transform: uppercase; }
  .chip.is-day2 { background: #2b6fd6; }
  .scope p { font-size: 22px; color: #f1dfe1; }
  .tile { position: relative; display: flex; flex-direction: column; align-items: center; border-radius: 14px; background: #7f2629; color: #fff; min-height: 0; }
  .rank { position: absolute; top: 10px; left: 14px; font-size: 20px; font-weight: 700; opacity: 0.65; }
  .art { width: 72%; aspect-ratio: 1; object-fit: contain; margin-top: -24%; filter: drop-shadow(0 6px 8px rgba(0, 0, 0, 0.35)); }
  .foot { align-self: stretch; margin-top: auto; padding: 10px 10px 14px; border-radius: 0 0 14px 14px; background: #572931; text-align: center; }
  .value-row { display: flex; align-items: center; justify-content: center; gap: 10px; }
  .value { font-size: 60px; color: #ffc549; letter-spacing: -0.01em; }
  .types { display: inline-flex; gap: 4px; }
  .name { display: block; margin-top: 4px; font-size: 24px; font-weight: 800; line-height: 1.15; }
  /* Portrait formats: four rows of three must fit under the band, so the
     art is smaller against the tile and the band is one line. Measured: a
     4:5 row gets about 190px, a 9:16 row about 290px. */
  .portrait .title h1, .story .title h1 { font-size: 50px; white-space: nowrap; }
  .portrait .mark strong { font-size: 46px; }
  .portrait .block { min-height: 0; padding: 14px 20px; }
  .portrait .grid { gap: 50px 16px; }
  .portrait .art { width: 46%; margin-top: -15%; }
  .portrait .foot { padding: 6px 8px 10px; }
  .portrait .value { font-size: 48px; }
  .portrait .name { font-size: 21px; }
  .story .block { min-height: 0; padding: 18px 22px; }
  .story .title h1 { font-size: 58px; }
  .story .art { width: 62%; margin-top: -20%; }
  .story .grid { gap: 78px 20px; }
  .story .value { font-size: 64px; }
  .story .name { font-size: 26px; }
  .type-sq { display: inline-flex; align-items: center; justify-content: center; border-radius: 6px; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.14); }
  .footer { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; margin-top: 16px; font-size: 20px; color: #4a5068; }
  .footer strong { color: #12131a; }
  .story .footer, .portrait .footer { flex-direction: column; gap: 4px; }
</style>
</head>
<body>
<div class="card-wrap {{ layout }}">
  <div class="surface">
    <div class="grid">
      {% set band %}
      <div class="band">
        <div class="block title"><h1 class="display">Top 12 Pokémon</h1><p>By share of teams</p></div>
        <div class="block mark"><strong class="display">{{ scope_label }}</strong><span>{{ sample }}</span></div>
        <div class="block scope"><span class="chip{{ ' is-day2' if phase == 'day2' else '' }}">{{ phase_label }}</span>{% if scope_note %}<p>{{ scope_note }}</p>{% endif %}</div>
      </div>
      {% endset %}
      {% if layout != 'landscape' %}{{ band }}{% endif %}
      {% for tile in tiles %}
      {% if layout == 'landscape' and loop.index0 == 6 %}{{ band }}{% endif %}
      <div class="tile">
        <span class="rank">{{ loop.index }}</span>
        {% if tile.art %}<img class="art" src="{{ tile.art }}" alt="">{% endif %}
        <div class="foot">
          <div class="value-row"><span class="value display">{{ tile.share }}</span><span class="types">{{ tile.types }}</span></div>
          <span class="name">{{ tile.name }}</span>
        </div>
      </div>
      {% endfor %}
      {% if layout == 'landscape' and tiles | length <= 6 %}{{ band }}{% endif %}
    </div>
    <div class="footer">
      <span><strong>Pokémon Champions Data</strong> · {{ citation }}</span>
      <span>{{ site }}</span>
    </div>
  </div>
</div>
</body>
</html>
