<!doctype html>
{# The embeddable Top 12 widget (docs/upgrade-plan-2027q2.md, list #33): a
   page for an <iframe> on a creator's site. It carries its own small
   payload (build.py's _embed_payload: each regulation's Top 12 boards, as
   the Overview shows them) and nothing else, so it loads without the
   dashboard's scripts or shards. Query parameters pick what it shows:

     reg    a regulation code ("m-c"), else the dashboard's default
     board  all | day2 | online (the board's Players switch)
     group  forms | species
     view   grid | list
     lang   en | ja | es | fr | de (Pokémon names only)
     theme  auto | light | dark

   Every view carries its citation: the figure, the sample, the source and
   a link back to the dashboard. #}
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>Top 12 Pokémon · Pokémon Champions Data</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Ccircle cx='8' cy='8' r='7' fill='%23e3323c'/%3E%3Crect y='7' width='16' height='2' fill='%2312131a'/%3E%3Ccircle cx='8' cy='8' r='2.5' fill='%23fff' stroke='%2312131a'/%3E%3C/svg%3E">
<style>
  @font-face {
    font-family: "Board Display";
    src: url("fonts/oswald-latin-wght.woff2") format("woff2");
    font-weight: 200 700;
    font-display: swap;
  }
  :root {
    --field: #ea0028;
    --field-ink: #84010c;
    --surface: #fff;
    --tile: #7f2629;
    --scrim: #572931;
    --gold: #ffc549;
    --ink: #16264d;
    --muted: #5b6b8c;
    --link: #2b5cad;
    --rule: #eaf1fb;
    --font-display: "Board Display", "Arial Narrow", sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --field: #9e0019; --field-ink: #5c0009; --surface: #181c25; --tile: #5a1b1e;
      --scrim: #3b1b21; --ink: #e6e9f2; --muted: #9aa6c2; --link: #6c9bef; --rule: #1f2a40;
    }
  }
  :root[data-theme="dark"] {
    --field: #9e0019; --field-ink: #5c0009; --surface: #181c25; --tile: #5a1b1e;
    --scrim: #3b1b21; --ink: #e6e9f2; --muted: #9aa6c2; --link: #6c9bef; --rule: #1f2a40;
  }
  * { box-sizing: border-box; }
  /* Transparent outside the card's red frame, so an iframe taller than
     the board shows the host page below it, not a block of red. */
  html, body { margin: 0; background: transparent; }
  body { font: 14px/1.35 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: var(--ink); }
  .embed { padding: 8px; border-radius: 14px; background: var(--field); }
  .embed-inner { background: var(--surface); border-radius: 10px; padding: 10px; }
  .embed-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 2px 10px; margin: 0 0 8px; }
  .embed-head h1 { margin: 0; font-family: var(--font-display); font-size: 1.5rem; font-weight: 700; font-style: italic; text-transform: uppercase; line-height: 1; color: var(--field); }
  .embed-scope { font-weight: 800; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .embed-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 6px; }
  .embed-tile a { position: relative; display: flex; flex-direction: column; align-items: center; height: 100%; padding: 4px 4px 0; border-radius: 8px; background: var(--tile); color: #fff; text-decoration: none; }
  .embed-tile a:hover, .embed-tile a:focus-visible { box-shadow: 0 0 0 3px var(--gold); outline: none; }
  .embed-rank { position: absolute; top: 3px; left: 6px; font-size: 0.65rem; font-weight: 700; opacity: 0.65; }
  .embed-tile img, .embed-blank { width: 64px; height: 64px; object-fit: contain; }
  .embed-foot { align-self: stretch; margin-top: auto; padding: 3px 4px 5px; border-radius: 0 0 8px 8px; background: var(--scrim); text-align: center; }
  .embed-value { display: block; font-family: var(--font-display); font-size: 1.35rem; font-weight: 700; line-height: 1; color: var(--gold); font-variant-numeric: tabular-nums; }
  .embed-name { display: block; font-weight: 800; font-size: 0.72rem; line-height: 1.15; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .embed-list { list-style: none; margin: 0; padding: 0; }
  .embed-list li + li { border-top: 1px solid var(--rule); }
  .embed-list a { display: grid; grid-template-columns: 1.8em 40px minmax(0, 1fr) auto; align-items: center; gap: 8px; min-height: 44px; color: inherit; text-decoration: none; }
  .embed-list img, .embed-list .embed-blank { width: 40px; height: 40px; }
  .embed-list .embed-rank { position: static; font-weight: 800; opacity: 0.7; text-align: right; }
  .embed-bar { display: block; height: 6px; margin-top: 3px; border-radius: 3px; background: var(--field); }
  .embed-list .embed-value { color: var(--ink); font-size: 1.2rem; }
  .embed-list .embed-name { font-size: 0.9rem; white-space: normal; }
  .embed-cite { margin: 8px 0 0; font-size: 0.75rem; color: var(--muted); }
  .embed-cite a { color: var(--link); font-weight: 700; }
  .embed-empty { margin: 16px 0; color: var(--muted); }
  @media (max-width: 559px) {
    .embed-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .embed-tile img, .embed-blank { width: 48px; height: 48px; }
    .embed-value { font-size: 1.15rem; }
    /* Two lines rather than an ellipsis: "Mega Raichu Y" at 80px. */
    .embed-grid .embed-name { white-space: normal; font-size: 0.66rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; min-height: 2.3em; }
  }
  @media (max-width: 359px) {
    /* Tighter frame and gaps leave each tile ~62px of text: "Gholdengo"
       and "Archaludon" whole. */
    .embed { padding: 6px; }
    .embed-inner { padding: 8px; }
    .embed-grid { gap: 4px; }
    .embed-foot { padding: 3px 2px 5px; }
    .embed-grid .embed-name { font-size: 0.6rem; letter-spacing: -0.01em; }
  }
  @media (max-width: 299px) {
    .embed-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
</head>
<body>
<main class="embed"><div class="embed-inner" id="embed" aria-live="polite"></div></main>
<script>window.EMBED_DATA = {{ embed_json | safe }};</script>
<script>
(function () {
  "use strict";
  var DATA = window.EMBED_DATA || {};
  var params = new URLSearchParams(location.search);
  var theme = params.get("theme");
  if (theme === "light" || theme === "dark") document.documentElement.setAttribute("data-theme", theme);
  var root = document.getElementById("embed");

  function esc(value) {
    return String(value == null ? "" : value).replace(/[&<>"']/g, function (c) {
      return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
    });
  }
  function pick(value, allowed, fallback) {
    return allowed.indexOf(value) !== -1 ? value : fallback;
  }

  var boards = DATA.boards || {};
  var reg = boards[params.get("reg")] ? params.get("reg") : DATA.default_regulation;
  var forReg = boards[reg] || {};
  var boardId = pick(params.get("board"), Object.keys(forReg), forReg.all ? "all" : Object.keys(forReg)[0]);
  var group = pick(params.get("group"), ["forms", "species"], "forms");
  var view = pick(params.get("view"), ["grid", "list"], "grid");
  var lang = pick(params.get("lang"), ["en"].concat(Object.keys(DATA.names || {})), "en");
  var board = forReg[boardId];

  var regName = reg === "all" ? "All regulations" : "Reg " + String(reg || "").toUpperCase();
  var site = DATA.site_url || "./";
  // Links open the dashboard on the same regulation and population.
  var query = "?reg=" + encodeURIComponent((reg || "") + (boardId === "online" ? ":online" : ""));
  var dashboardHref = site + query + "#/overview";

  function nameOf(tile) {
    return ((DATA.names || {})[lang] || {})[tile.k] || tile.n || tile.k;
  }
  function image(tile, size) {
    var src = (DATA.images || {})[tile.k];
    return src
      ? '<img src="' + esc(src) + '" alt="" width="' + size + '" height="' + size + '" loading="lazy" decoding="async">'
      : '<span class="embed-blank"></span>';
  }
  function percent(share) {
    return share == null ? "—" : (share * 100).toFixed(1) + "%";
  }

  if (!board || !(board[group] || []).length) {
    root.innerHTML = '<p class="embed-empty">No usage recorded for ' + esc(regName) + ' yet. ' +
      '<a href="' + esc(site) + '" target="_blank" rel="noopener">Open the dashboard</a>.</p>';
    return;
  }
  var tiles = board[group];
  var top = tiles[0].s || 0;
  var body = view === "list"
    ? '<ol class="embed-list">' + tiles.map(function (t, i) {
        return '<li><a href="' + esc(site + query + "#/pokemon/" + encodeURIComponent(t.k)) + '" target="_blank" rel="noopener">' +
          '<span class="embed-rank">' + (i + 1) + "</span>" + image(t, 40) +
          '<span><span class="embed-name">' + esc(nameOf(t)) + '</span><span class="embed-bar" style="width:' +
          (top ? Math.max(2, Math.round((t.s || 0) / top * 100)) : 0) + '%"></span></span>' +
          '<span class="embed-value">' + percent(t.s) + "</span></a></li>";
      }).join("") + "</ol>"
    : '<ol class="embed-grid">' + tiles.map(function (t, i) {
        return '<li class="embed-tile"><a href="' + esc(site + query + "#/pokemon/" + encodeURIComponent(t.k)) + '" target="_blank" rel="noopener" ' +
          'aria-label="' + esc((i + 1) + ". " + nameOf(t) + ", " + percent(t.s) + " of teams") + '">' +
          '<span class="embed-rank" aria-hidden="true">' + (i + 1) + "</span>" + image(t, 64) +
          '<span class="embed-foot" aria-hidden="true"><span class="embed-value">' + percent(t.s) + "</span>" +
          '<span class="embed-name">' + esc(nameOf(t)) + "</span></span></a></li>";
      }).join("") + "</ol>";
  var population = boardId === "online" ? "Limitless online tournaments" : boardId === "day2" ? "official events, Day 2 teams" : "official events";
  var updated = DATA.generated_at_utc ? new Date(Date.parse(DATA.generated_at_utc)) : null;
  root.innerHTML =
    '<div class="embed-head"><h1>Top 12 Pokémon</h1><span class="embed-scope">' + esc(regName) + " · " + esc(board.label || "") + "</span></div>" +
    body +
    '<p class="embed-cite">Share of teams carrying each Pokémon, ' + esc(population) + ": " +
    esc((board.team_count || 0).toLocaleString()) + " teams from " + esc((board.event_count || 0).toLocaleString()) +
    (board.event_count === 1 ? " event" : " events") +
    (updated && !isNaN(updated) ? ", updated " + esc(updated.toLocaleDateString(undefined, { day: "numeric", month: "short", year: "numeric" })) : "") +
    '. Pokémon Champions Data, an unofficial fan project. <a href="' + esc(dashboardHref) + '" target="_blank" rel="noopener">See the full data</a></p>';
})();
</script>
</body>
</html>
