  @media (max-width: 1023px) { .team-strip { grid-template-columns: repeat(var(--strip-n), minmax(0, 56px)); } }
  .strip-pop { position: absolute; z-index: 70; padding: var(--space-3); border-radius: var(--radius-md); border: 2px solid var(--border); background: var(--surface); color: var(--navy); box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25); font-size: var(--font-sm); }
