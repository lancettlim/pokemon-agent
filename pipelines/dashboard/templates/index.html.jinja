  .board-band-scope .segmented button { color: #e8e0e1; }
  .board-band-scope .segmented button[aria-pressed="true"] { background: #fff; color: var(--board-tile); }
  .board-controls { display: flex; flex-wrap: wrap; gap: 6px; }
  .board-tile {
    position: relative;
