  .board-foot { align-self: stretch; margin-top: auto; padding: 6px 8px 8px; border-radius: 0 0 var(--radius-md) var(--radius-md); background: var(--board-scrim); text-align: center; }
  .board-value-row { display: flex; align-items: center; justify-content: center; gap: 6px; }
