  .spread-list li { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 2px var(--space-3); padding: var(--space-2) 0; border-bottom: 1px solid color-mix(in srgb, var(--muted) 20%, transparent); }
  .spread-points { font-variant-numeric: tabular-nums; }
