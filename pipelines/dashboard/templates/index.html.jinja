  .strip-pop dt { color: var(--muted); font-weight: 600; }
  .strip-pop dd { margin: 0; font-weight: 600; }
  .strip-pop .cell-icon { width: 24px; height: 24px; }
  .strip-pop-moves { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 2px var(--space-2); }
  /* Player line and scoreboard row (V4): name · country · record in chips. */
  .sb-player { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px; min-width: 0; }
  .sb-name { font-weight: 800; color: var(--navy); text-transform: uppercase; letter-spacing: 0.02em; overflow-wrap: anywhere; }
