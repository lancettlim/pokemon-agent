  .board-form { font-size: 0.78em; font-weight: 700; opacity: 0.85; }
  .board-more { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: var(--space-2) var(--space-3); margin: var(--space-3) 0 0; font-size: var(--font-sm); }
