  .section-head { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); margin: var(--space-5) 0 var(--space-2); }
  .section-head h3 { margin: 0; }

  /* The Overview has no card of its own: the board is its hero, and the
     panels below it carry their own frames. */
  .tab-panel[data-panel="overview"] { background: none; border: 0; padding: 0; overflow: visible; }
  .overview-card { border: 2px solid var(--border); border-radius: var(--radius-md); background: var(--surface); padding: var(--space-4); }

  /* Top 12 board (V2): the official card's 6 + band + 6 on desktop, band on
