<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pokémon Champions — Analytics Dashboard</title>
<script>
  // Apply a saved Light/Dark choice before first paint (no flash of the
  // wrong theme). "auto" or nothing saved follows prefers-color-scheme.
  try {
    var savedTheme = localStorage.getItem("dashboard-theme");
    if (savedTheme === "light" || savedTheme === "dark") {
      document.documentElement.setAttribute("data-theme", savedTheme);
    }
  } catch (e) {}
</script>
<style>
  /* ---------------------------------------------------------------
   * Design tokens — see docs/design-system.md for the full token
   * reference, component catalog, and Pokémon-representation/naming
   * conventions this dashboard follows. Every color, spacing, and
   * radius value used below traces back to one of these variables so
   * the two stay in sync.
   * --------------------------------------------------------------- */
  :root {
    /* Color */
    --navy: #16264d;
    --blue: #2b5cad;
    --light-blue: #eaf1fb;
    --border: #16264d;
    --muted: #5b6b8c;
    --bg: #f4f6fb;
    --surface: #fff;
    --positive: #1f8a4c;
    --positive-bg: #e8f7ee;
    --warning: #a8710a;
    --warning-bg: #fbf1e0;
    --danger: #b23434;
    --danger-bg: #fbe9e9;

    /* Broadcast/esports theme tokens (docs/design-system.md's "Broadcast
       color-block header" component) — color-blocking + weight/case is
       what gives this a broadcast-graphic feel, deliberately without
       adding a webfont dependency. */
    --panel-dark: #12131a;
    --accent-red: #e3323c;
    --accent-red-bg: #fce7e8;
    --accent-gold: #f4b942;
    --accent-gold-bg: #fdf3dd;

    /* Icon-size scale (docs/design-system.md's "Icon size scale") — every
       sprite/item/type icon must use one of these three tokens, no other
       pixel value, replacing four previously ad-hoc sizes (40/32/24/22px).
       --icon-xl is a deliberate 4th tier, reserved for the Pokémon Profile
       header's dual-type badge (a new, hero-level piece of information —
       see "Larger type badge" in docs/design-system.md). */
    --icon-sm: 40px;
    --icon-md: 64px;
    --icon-lg: 96px;
    --icon-xl: 128px;

    /* Per-type accent colors (docs/design-system.md's "Type color
       accents"). Emitted from pipelines/render/template.py's TYPE_COLORS
       via build.py's _type_colors() rather than hardcoded here, so the
       dashboard and the team-card renderer share one palette. Used as
       accents (borders, gradients) rather than fills — the broadcast
       palette above stays the page's identity. */
    {%- for type_name, hex in payload.type_colors.items() | sort %}
    --type-{{ type_name }}: {{ hex }};
    {%- endfor %}
    --type-unknown: #6B7280;

    /* Speed-tier badge scale (docs/design-system.md's "Speed-tier badge"
       component) — bucketed off pokemon_champions_profile.speed. */
    --speed-blazing: #b23434;
    --speed-blazing-bg: #fbe9e9;
    --speed-fast: #a8710a;
    --speed-fast-bg: #fbf1e0;
    --speed-average: #2b5cad;
    --speed-average-bg: #eaf1fb;
    --speed-slow: #5b6b8c;
    --speed-slow-bg: #eef0f5;

    /* Spacing scale (4px base unit) */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 20px;
    --space-6: 24px;
    --space-8: 32px;

    /* Radius scale */
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-pill: 999px;

    /* Type scale */
    --font-xs: 0.8rem;
    --font-sm: 0.85rem;
    --font-base: 0.9rem;
    --font-md: 0.95rem;
    --font-lg: 1.1rem;
    --font-xl: 1.5rem;
    --font-2xl: 1.6rem;
  }
  * { box-sizing: border-box; }
  /* Dark theme (docs/upgrade-plan-2026q4.md, B8): the same tokens, redefined.
     Follows the OS setting unless the header toggle pinned Light or Dark
     (data-theme on <html>). Type colors stay as they are: they're accents
     on borders and pills and read on both backgrounds. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --navy: #e6e9f2;
      --blue: #6c9bef;
      --light-blue: #1f2a40;
      --border: #3a4560;
      --muted: #9aa6c2;
      --bg: #0f1218;
      --surface: #181c25;
      --positive: #4fc27f;
      --positive-bg: #12301f;
      --warning: #e0a94a;
      --warning-bg: #33280f;
      --danger: #ef6b6b;
      --danger-bg: #3a1717;
      --panel-dark: #07080c;
      --accent-red-bg: #3a1a1d;
      --accent-gold-bg: #3a2f12;
      --speed-blazing: #ef6b6b;
      --speed-blazing-bg: #3a1717;
      --speed-fast: #e0a94a;
      --speed-fast-bg: #33280f;
      --speed-average: #6c9bef;
      --speed-average-bg: #1f2a40;
      --speed-slow: #9aa6c2;
      --speed-slow-bg: #252b38;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --navy: #e6e9f2;
    --blue: #6c9bef;
    --light-blue: #1f2a40;
    --border: #3a4560;
    --muted: #9aa6c2;
    --bg: #0f1218;
    --surface: #181c25;
    --positive: #4fc27f;
    --positive-bg: #12301f;
    --warning: #e0a94a;
    --warning-bg: #33280f;
    --danger: #ef6b6b;
    --danger-bg: #3a1717;
    --panel-dark: #07080c;
    --accent-red-bg: #3a1a1d;
    --accent-gold-bg: #3a2f12;
    --speed-blazing: #ef6b6b;
    --speed-blazing-bg: #3a1717;
    --speed-fast: #e0a94a;
    --speed-fast-bg: #33280f;
    --speed-average: #6c9bef;
    --speed-average-bg: #1f2a40;
    --speed-slow: #9aa6c2;
    --speed-slow-bg: #252b38;
    color-scheme: dark;
  }

  /* Keyboard focus is always visible; motion is cut for those who ask. */
  :focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
  }

  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: var(--bg);
    color: var(--navy);
  }
  header {
    background: var(--panel-dark);
    color: #fff;
    padding: 24px;
    text-align: center;
  }
  header h1 {
    margin: 0;
    font-size: 1.6rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 800;
  }
  header p { margin: 4px 0 0; color: #b8bdd1; font-size: 0.9rem; }
  main { max-width: 1100px; margin: 0 auto; padding: 24px; }
  /* Components that set their own display (grid/flex) would otherwise
     override the hidden attribute app.js toggles. */
  .kpi-row[hidden], .movers-panel[hidden] { display: none; }
  /* Tier List (app.js setupTiers): usage bands, win-rate chip per Pokémon. */
  .tier-row { display: grid; grid-template-columns: 64px 1fr; gap: var(--space-3); align-items: stretch; margin-bottom: var(--space-3); }
  .tier-label { display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 10px; color: #fff; font-weight: 800; font-size: 1.6rem; line-height: 1; }
  .tier-label small { font-size: 0.65rem; font-weight: 600; margin-top: 4px; opacity: 0.9; }
  .tier-s { background: var(--accent-red); }
  .tier-a { background: #e8622c; }
  .tier-b { background: var(--accent-gold); color: var(--navy); }
  .tier-c { background: var(--muted); }
  .tier-members { display: flex; flex-wrap: wrap; gap: var(--space-2); border: 2px solid var(--border); border-radius: 10px; padding: var(--space-2); }
  .tier-chip { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px 4px 4px; border-radius: 999px; background: var(--light-blue); font-weight: 600; font-size: 0.9rem; border: 0; cursor: pointer; font-family: inherit; color: var(--navy); }
  .tier-chip:hover { outline: 2px solid var(--blue); }
  .tier-wr { font-size: 0.75rem; font-weight: 700; padding: 1px 6px; border-radius: 999px; background: var(--surface); color: var(--muted); }
  .tier-wr.is-strong { color: var(--positive); }
  .tier-wr.is-weak { color: var(--danger); }
  /* Pokémon Profile: stat bars against the format median, and the
     most-common-set card beside them (app.js statBarsHtml/commonSetHtml). */
  .profile-layout { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--space-5); align-items: start; margin-bottom: var(--space-5); }
  .profile-usage-line { margin: var(--space-1) 0 var(--space-3); color: var(--muted); }
  .stat-bars { min-width: 260px; }
  .stat-bar-row { display: grid; grid-template-columns: 2.5em 2.5em 1fr; align-items: center; gap: var(--space-2); margin: 3px 0; font-variant-numeric: tabular-nums; }
  .stat-label { color: var(--muted); font-weight: 600; font-size: 0.85rem; }
  .stat-value { font-weight: 700; text-align: right; }
  .stat-track { position: relative; height: 10px; background: var(--light-blue); border-radius: 999px; }
  .stat-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 999px; background: var(--blue); }
  .stat-fill.is-high { background: var(--positive); }
  .stat-fill.is-low { background: var(--warning); }
  .stat-median { position: absolute; top: -3px; bottom: -3px; width: 2px; background: var(--navy); }
  .stat-legend { font-size: 0.8rem; color: var(--muted); margin: var(--space-2) 0 0; }
  .common-set { border: 2px solid var(--border); border-radius: 10px; padding: var(--space-4); background: var(--surface); }
  .common-set-head { display: flex; justify-content: space-between; align-items: center; gap: var(--space-2); }
  .common-set h3 { margin: 0; font-size: 1rem; }
  .common-set dl { display: grid; grid-template-columns: auto 1fr; gap: 4px var(--space-3); margin: var(--space-3) 0; }
  .common-set dt { color: var(--muted); font-weight: 600; }
  .common-set dd { margin: 0; font-weight: 600; }
  .set-moves { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 4px var(--space-3); }
  .set-sample { font-size: 0.85rem; color: var(--muted); margin: 0 0 var(--space-2); }
  .set-sample.is-thin { color: var(--warning); font-weight: 600; }
  .set-share { color: var(--muted); font-weight: 400; font-size: 0.85rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 720px) { .profile-layout { grid-template-columns: 1fr; } }
  /* Phones: the header keeps its title and the Regulation picker only. */
  @media (max-width: 480px) {
    header { padding: 14px 12px; }
    header h1 { font-size: 1.1rem; }
    header > p, .header-meta .header-chip:not(.regulation-picker) { display: none; }
    .kpi-card .kpi-sprite { display: none; }
    .kpi-card .sub { display: none; }
    .kpi-card .value { font-size: 1.05rem; }
  }
  /* Pokémon search combobox (app.js attachPokemonCombobox). The original
     <select> stays in the DOM as the source of truth, visually hidden. */
  .combo { position: relative; display: inline-block; min-width: 240px; }
  .combo-input {
    width: 100%;
    font: inherit;
    padding: 8px 10px;
    border: 2px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .combo-input:focus { outline: 3px solid var(--blue); outline-offset: 1px; }
  .combo-list {
    position: absolute;
    z-index: 30;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    max-height: 360px;
    overflow-y: auto;
    margin: 0;
    padding: 4px;
    list-style: none;
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: var(--radius-sm);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
  }
  .combo-list li { display: flex; align-items: center; gap: var(--space-2); padding: 4px 8px; border-radius: var(--radius-sm); cursor: pointer; }
  .combo-list li[aria-selected="true"] { background: var(--light-blue); }
  .combo-list .combo-empty { color: var(--muted); cursor: default; }
  .combo-list[hidden] { display: none; }
  .combo-source { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .theme-toggle { font: inherit; cursor: pointer; background: transparent; color: inherit; }
  .regulation-picker { display: inline-flex; align-items: center; gap: var(--space-2); }
  .regulation-picker select {
    font: inherit;
    font-weight: 700;
    border-radius: var(--radius-sm);
    border: 1px solid #b8bdd1;
    padding: 2px 6px;
  }
  .movers-panel {
    border: 2px solid var(--border);
    border-radius: 10px;
    padding: var(--space-4) var(--space-5);
    margin-bottom: var(--space-5);
  }
  .movers-panel h3 { margin: 0 0 var(--space-1); }
  .movers-panel h4 { margin: var(--space-3) 0 var(--space-2); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.03em; color: var(--muted); }
  .mover-columns { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-4); }
  .mover-list { list-style: none; margin: 0; padding: 0; }
  .mover-list li { display: flex; align-items: center; gap: var(--space-2); padding: 2px 0; }
  .mover-name { flex: 1; font-weight: 600; min-width: 0; }
  .mover-share { color: var(--muted); font-variant-numeric: tabular-nums; }
  .mover-delta { font-weight: 700; font-variant-numeric: tabular-nums; min-width: 5.5em; text-align: right; }
  .mover-delta.is-up { color: var(--positive); }
  .mover-delta.is-down { color: var(--danger); }
  .staleness-banner {
    background: var(--warning-bg);
    color: var(--warning);
    border-bottom: 2px solid var(--warning);
    padding: var(--space-3) var(--space-5);
    text-align: center;
    font-weight: 600;
  }

  .kpi-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin-bottom: 32px;
  }
  .kpi-card {
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: 10px;
    padding: var(--space-5);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .kpi-card .kpi-sprite { width: var(--icon-lg); height: var(--icon-lg); object-fit: contain; flex: 0 0 auto; }
  .kpi-card .kpi-body { min-width: 0; }
  .kpi-card .label { font-size: 0.8rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.03em; }
  /* Names wrap only between words ("Mega Charizard Y"); break-word used to
     split long single-word names mid-word. */
  .kpi-card .value { font-size: 1.35rem; line-height: 1.2; font-weight: 700; margin-top: 4px; overflow-wrap: normal; word-break: normal; }
  .kpi-card .sub { font-size: 0.85rem; color: var(--muted); margin-top: 2px; }

  /* --- Tabs --- */
  /* Wraps onto a second row on wide screens, so no tab is ever clipped
     off the right edge with no hint that it exists. Narrow screens keep
     the single scrollable row (see the max-width:720px block). */
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border-bottom: 2px solid var(--border);
    margin-bottom: 20px;
  }
  .sections {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    gap: var(--space-1);
    background: var(--bg);
    padding: var(--space-2) 0;
    margin-bottom: var(--space-1);
  }
  .section-btn {
    flex: 0 0 auto;
    font: inherit;
    font-weight: 700;
    font-size: 1rem;
    color: var(--navy);
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 8px 18px;
    cursor: pointer;
  }
  .section-btn:hover { border-color: var(--blue); }
  .section-btn[aria-current="true"] { background: var(--panel-dark); border-color: var(--panel-dark); color: #fff; }
  .tab-btn[hidden], .tabs[hidden], #kpi-strip[hidden] { display: none; }
  .tab-btn {
    flex: 0 0 auto;
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 600;
    padding: 10px 16px;
    cursor: pointer;
    white-space: nowrap;
  }
  .tab-btn:hover { color: var(--navy); }
  .tab-btn[aria-selected="true"] {
    color: var(--accent-red);
    border-bottom-color: var(--accent-red);
  }
  .tab-panel[hidden] { display: none; }

  /* --- Sub-tabs: a compact pill row nested inside one top-level tab/
     section (e.g. Usage's leaderboards, Pokémon Profile's Items/Ability/
     Moves/Team Cores), so several equally-important views can share one
     section instead of stacking. Deliberately visually lighter than the
     top-level `.tabs` row above, which stays reserved for the page's
     ten main tabs. --- */
  .subtabs {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }
  .subtab-btn {
    flex: 0 0 auto;
    background: var(--light-blue);
    border: none;
    border-radius: var(--radius-pill);
    color: var(--muted);
    font-size: var(--font-sm);
    font-weight: 600;
    padding: 6px 14px;
    cursor: pointer;
    white-space: nowrap;
  }
  .subtab-btn:hover { color: var(--navy); }
  .subtab-btn[aria-selected="true"] { background: var(--blue); color: #fff; }
  .subtab-panel[hidden] { display: none; }

  section {
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: 10px;
    padding: 0 var(--space-8) var(--space-8);
    margin-bottom: var(--space-6);
    overflow: hidden;
  }
  /* Broadcast color-block section header (docs/design-system.md) — bold,
     uppercase, letter-spaced, on a dark bar, replacing plain
     text-on-white section titles. */
  section h2 {
    margin: 0 calc(var(--space-8) * -1) var(--space-4);
    padding: var(--space-4) var(--space-8);
    background: var(--panel-dark);
    color: #fff;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 800;
  }
  section h3 { font-size: var(--font-md); text-transform: uppercase; letter-spacing: 0.03em; color: var(--muted); }
  .controls { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; align-items: flex-end; }
  .controls label { font-size: 0.85rem; color: var(--muted); display: flex; flex-direction: column; gap: 4px; }
  select {
    padding: 6px 8px;
    border-radius: 6px;
    border: 1px solid var(--border);
    font-size: 16px; /* prevents iOS Safari auto-zoom-on-focus */
  }
  /* Range filter (min/max pair — stat-range, usage/win-rate range) */
  .range-filter { display: flex; align-items: center; gap: 4px; }
  .range-filter input[type="number"] {
    width: 4.5em;
    padding: 6px 8px;
    border-radius: 6px;
    border: 1px solid var(--border);
    font-size: 16px;
  }
  .type-filter-row { display: flex; flex-wrap: wrap; gap: 4px; max-width: 320px; }

  .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  th, td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--light-blue); white-space: nowrap; }
  th { color: var(--muted); font-weight: 600; }
  th.sortable { cursor: pointer; user-select: none; }
  th.sortable:hover { color: var(--navy); }
  th.sortable .sort-indicator { margin-left: 4px; color: var(--accent-red); }

  /* Sprite/icon cells populated by app.js's pokemonCell()/iconCell() helpers */
  .cell-with-icon { display: flex; align-items: center; gap: 8px; }
  .cell-icon { width: var(--icon-sm); height: var(--icon-sm); object-fit: contain; flex: 0 0 auto; }

  /* Small muted annotation next to a value (Win rate leaders table's
     "(n=X)" sample-size note — see "Percentages, not raw counts" in
     docs/design-system.md). */
  .ranked-value { color: var(--muted); font-weight: 700; white-space: nowrap; }

  /* --- 6-wide grid (docs/design-system.md's "3-tier tab layout
     convention" tier 2, and the ".grid-6xn component"): the dashboard's
     one component for any usage/win-rate metric and for a spotlight
     grid of Pokémon (Overview's Top 12), replacing the old ranked-list
     bars and the separate spotlight-grid/spotlight-card pattern. Fixed 6
     columns on desktop (not auto-fill/auto-fit — a deliberately denser,
     more uniform grid), collapsing to 3 columns at 720px and 2 at 480px
     per the existing breakpoint convention. Each tile bolds its headline
     percentage (.grid-6xn-value) per the "bold the percentage" ask. */
  .grid-6xn { display: grid; grid-template-columns: repeat(6, 1fr); gap: var(--space-3); }
  .grid-6xn-tile {
    border: 2px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-1);
    position: relative;
  }
  .grid-6xn-tile.is-leader { border-color: var(--accent-red); background: var(--accent-red-bg); }

  /* Type color accent (docs/design-system.md's "Type color accents"): a
     left-edge bar in the Pokémon's own type colors, painted from the
     --tile-accent custom property app.js sets per element. An accent, not
     a fill — the broadcast palette stays the page's identity, and the
     .is-leader treatment above still reads over the top of it. */
  .has-type-accent { position: relative; overflow: hidden; }
  .has-type-accent::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 6px;
    background: var(--tile-accent, var(--type-unknown));
  }

  /* A team drawn as its six Pokémon (app.js's teamCompositionHtml). Wraps
     to two rows at narrow widths rather than overflowing its tile. */
  .team-comp {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1);
  }
  .team-comp-slot { display: inline-flex; align-items: center; }
  .team-comp-slot img { display: block; }
  /* Placeholder for a roster slot whose sprite didn't resolve, so a
     six-Pokémon team still reads as six. */
  .team-comp-blank {
    display: inline-block;
    width: var(--icon-sm);
    height: var(--icon-sm);
    border-radius: 50%;
    background: var(--light-blue);
  }

  /* Hero art (pokemon_asset's home_render kind) is a transparent-background
     render, drawn at --icon-lg/--icon-xl. Unlike the menu sprites it is
     downscaled rather than upscaled, so it needs no rendering hint. */
  .hero-art { object-fit: contain; }

  /* Country flag glyph. Sized up slightly against the code beside it,
     which always stays visible — see countryCell() in app.js. */
  .country-flag { font-size: 1.15em; line-height: 1; }
  /* Normal flow, left-aligned within the centered column — not absolutely
     positioned, so it reserves its own row instead of overlapping the
     label when a tile has no icon (e.g. an item/ability/move/team with no
     resolvable sprite). */
  .grid-6xn-tile .badge-rank { align-self: flex-start; }
  .grid-6xn-tile img { width: var(--icon-md); height: var(--icon-md); object-fit: contain; }
  .grid-6xn-tile .grid-6xn-label { font-weight: 600; font-size: var(--font-xs); overflow-wrap: anywhere; }
  .grid-6xn-value { font-weight: 800; font-size: var(--font-lg); color: var(--navy); }
  .grid-6xn-tile.is-leader .grid-6xn-value { color: var(--accent-red); }
  .grid-6xn-sub { font-size: var(--font-xs); color: var(--muted); }

  /* --- Pro Team Gallery card grid --- */
  .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--space-4); }
  .gallery-card { border: 2px solid var(--border); border-radius: var(--radius-md); overflow: hidden; display: flex; flex-direction: column; }
  .gallery-card img.gallery-card-image { width: 100%; display: block; }
  .gallery-card .gallery-card-body { padding: var(--space-4); display: flex; flex-direction: column; gap: var(--space-1); }
  .gallery-card .gallery-card-player { font-weight: 700; }
  .gallery-card .gallery-card-meta { font-size: var(--font-xs); color: var(--muted); }

  .empty-state {
    background: var(--light-blue);
    border-radius: 8px;
    padding: 14px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* --- Badge (rank pills, speed tiers — see docs/design-system.md) --- */
  .badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    font-size: var(--font-xs);
    font-weight: 600;
    white-space: nowrap;
  }
  .badge-rank { background: var(--light-blue); color: var(--blue); }
  .badge-speed-blazing { background: var(--speed-blazing-bg); color: var(--speed-blazing); }
  .badge-speed-fast { background: var(--speed-fast-bg); color: var(--speed-fast); }
  .badge-speed-average { background: var(--speed-average-bg); color: var(--speed-average); }
  .badge-speed-slow { background: var(--speed-slow-bg); color: var(--speed-slow); }
  .badge-positive { background: var(--positive-bg); color: var(--positive); }
  .badge-negative { background: var(--danger-bg); color: var(--danger); }

  /* Data & Sources tab. Table cells there hold prose and endpoint URLs
     rather than the short numeric values every other table has, so they
     opt into wrapping instead of forcing the row wider. */
  .wrap-cell { white-space: normal; min-width: 220px; max-width: 420px; }
  .wrap-cell code { font-size: var(--font-xs); word-break: break-all; }
  .caveat-list {
    margin: 0;
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    color: var(--muted);
  }
  .caveat-list strong { color: var(--navy); }
  /* Freshness chip in the page header: dataset version + snapshot date,
     visible without opening the Data & Sources tab. */
  .header-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }
  .header-chip {
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: var(--radius-pill);
    padding: 2px var(--space-3);
    font-size: var(--font-xs);
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .badge-new { background: var(--accent-gold-bg); color: var(--warning); }

  /* --- Type badge (Pokémon Profile header, Matchup tab pickers) — the
     dashboard's first-ever Pokémon-type display (pokemon.type_1/type_2,
     PokéAPI). Icon-only emblems (no visible text label) — the type name
     is exposed via the pill's aria-label/the icon's title attribute
     instead, so it stays accessible without cluttering the badge. Uses
     --icon-xl for hero-level prominence, the one documented exception to
     the 3-tier icon scale. --- */
  .type-badge-row { display: flex; align-items: center; gap: var(--space-2); }
  .type-pill { display: inline-flex; align-items: center; justify-content: center; }

  /* Profile header's dual-type display — the one place a type icon uses
     --icon-xl instead of the sm/md/lg scale (see "Icon size scale" above). */
  .type-badge-row.type-badge-lg { gap: var(--space-3); margin: var(--space-2) 0; }
  /* A labelled pill tinted with the type's own color: an icon plus the
     type name reads faster than a bare emblem, and stays smaller than the
     Pokémon's art beside it (see renderTypeBadgeRow in app.js). */
  .type-badge-lg .type-pill-lg {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border-radius: 999px;
    padding: 4px 12px 4px 6px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: capitalize;
    color: #fff;
    background: var(--pill-type-color, var(--type-unknown));
  }

  /* Crops static/icons/types/*.png (wide 200x40 "icon + type name" badges,
     not bare square icons) down to just the icon's fixed-width left
     square, so every type-icon use (compact pills, the large Profile
     badge, the Matchup effectiveness grid, filter chips) shows a real
     icon-only emblem instead of a squished text badge — see
     typeIconImg() in app.js. */
  .type-icon-crop { display: inline-block; overflow: hidden; border-radius: var(--radius-sm); vertical-align: -3px; }
  .type-icon-crop img { display: block; }

  /* --- Descriptive sub-text under a name (Pokémon Profile's Items/
     Ability/Moves sections; Matchup panel move picker) --- */
  .desc-text { font-size: var(--font-xs); color: var(--muted); margin-top: 2px; }

  /* --- Matchup tab: type-effectiveness grid + damage calculator --- */
  .type-effect-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); gap: var(--space-2); }
  .type-effect-tile {
    border-radius: var(--radius-sm);
    padding: var(--space-2);
    text-align: center;
    font-size: var(--font-xs);
    font-weight: 700;
    text-transform: uppercase;
  }
  .type-effect-4x { background: #1f8a4c; color: #fff; }
  .type-effect-2x { background: #bfe3cd; color: #1f8a4c; }
  .type-effect-1x { background: var(--light-blue); color: var(--muted); }
  .type-effect-half { background: #fbe3c9; color: var(--warning); }
  .type-effect-quarter { background: var(--danger-bg); color: var(--danger); }
  .type-effect-0x { background: var(--navy); color: #fff; }

  .matchup-picker-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .matchup-side { border: 1px solid var(--light-blue); border-radius: var(--radius-md); padding: var(--space-4); }
  .matchup-side h4 { margin: 0 0 var(--space-2); }
  .stage-row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); margin-bottom: var(--space-1); }
  .stage-row label { font-size: var(--font-xs); color: var(--muted); flex: 0 0 60px; }
  .stage-row input[type="range"] { flex: 1 1 auto; }
  .stage-row .stage-value { width: 2.2em; text-align: right; font-weight: 700; font-size: var(--font-xs); }

  .damage-result { background: var(--light-blue); border-radius: var(--radius-md); padding: var(--space-4); margin-top: var(--space-4); text-align: center; }
  .damage-result .damage-range { font-size: var(--font-2xl); font-weight: 800; color: var(--navy); }
  .damage-result .damage-sub { font-size: var(--font-sm); color: var(--muted); margin-top: var(--space-1); }
  .toggle-chip-row { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-2); }
  .toggle-chip {
    font-size: var(--font-xs);
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--surface);
    cursor: pointer;
  }
  .toggle-chip[aria-pressed="true"] { background: var(--blue); border-color: var(--blue); color: #fff; }

  /* --- Top Teams tab: leaderboard tiles + pokepaste import/export --- */
  .pokepaste-box { display: flex; flex-direction: column; gap: var(--space-2); margin-bottom: var(--space-4); }
  .pokepaste-box textarea {
    width: 100%;
    min-height: 140px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: var(--font-sm);
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    resize: vertical;
  }
  .pokepaste-actions { display: flex; gap: var(--space-2); align-items: center; }
  .pokepaste-status { font-size: var(--font-xs); color: var(--muted); }

  /* --- Buttons --- */
  .btn {
    font: inherit;
    font-size: var(--font-sm);
    font-weight: 600;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--navy);
    cursor: pointer;
  }
  .btn:hover { background: var(--light-blue); }
  .btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .btn-primary { background: var(--blue); color: #fff; border-color: var(--blue); }
  .btn-primary:hover { background: var(--navy); }
  .btn-primary:disabled { background: var(--muted); border-color: var(--muted); }
  .btn-remove {
    background: none;
    border: none;
    color: var(--danger);
    font-size: var(--font-md);
    cursor: pointer;
    line-height: 1;
    padding: 2px 6px;
  }
  .btn-remove:hover { text-decoration: underline; }
  .btn-sm { padding: 4px 10px; font-size: var(--font-xs); }

  input[type="text"] {
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    font-size: 16px; /* prevents iOS Safari auto-zoom-on-focus */
    width: 100%;
  }

  /* --- Team Builder --- */
  .team-builder-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }
  .roster-picker { display: flex; flex-direction: column; gap: var(--space-3); }
  .roster-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 420px;
    overflow-y: auto;
    border: 1px solid var(--light-blue);
    border-radius: var(--radius-sm);
  }
  .roster-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--light-blue);
  }
  .roster-item:last-child { border-bottom: none; }
  .roster-item .roster-info { flex: 1 1 auto; min-width: 0; }
  .roster-item .roster-name { font-weight: 600; }
  .roster-item .roster-sub { font-size: var(--font-xs); color: var(--muted); }

  .team-slots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }
  .team-slot {
    border: 2px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    text-align: center;
    min-height: 96px;
    justify-content: center;
  }
  .team-slot.empty { border-style: dashed; color: var(--muted); font-size: var(--font-xs); }
  .team-slot img { width: var(--icon-lg); height: var(--icon-lg); object-fit: contain; }
  .team-slot .slot-name { font-weight: 600; font-size: var(--font-sm); }
  .team-slot .slot-detail { font-size: var(--font-xs); color: var(--muted); }
  .team-slot select { width: 100%; margin-top: 2px; }
  .team-slot .slot-move-selects { display: flex; flex-direction: column; gap: 2px; width: 100%; }

  .speed-order-list { list-style: none; margin: 0; padding: 0; }
  .speed-order-list li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) 0;
  }
  .speed-order-list .speed-value { margin-left: auto; font-weight: 600; }

  .stat-summary-row {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }
  .stat-summary-row .stat {
    background: var(--light-blue);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    font-size: var(--font-sm);
  }
  .stat-summary-row .stat strong { display: block; font-size: var(--font-lg); color: var(--navy); }

  /* --- Team Analyst --- */
  .team-analysis { margin-top: var(--space-6); border-top: 2px solid var(--light-blue); padding-top: var(--space-4); }
  .team-analysis h3 { margin-top: 0; }
  .team-analysis h4 { margin-bottom: var(--space-2); }
  .team-analysis-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-3); }
  .analysis-card { background: var(--light-blue); border-radius: var(--radius-md); padding: var(--space-3); }
  .analysis-card strong { display: block; color: var(--navy); font-size: var(--font-lg); }
  .analysis-card span { color: var(--muted); font-size: var(--font-xs); }
  .team-analysis-columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); margin-top: var(--space-5); }
  .team-analysis table { font-size: var(--font-sm); }
  .team-analysis .status-good { color: var(--positive); font-weight: 700; }
  .team-analysis .status-warn { color: var(--warning); font-weight: 700; }

  @media (max-width: 720px) {
    .tabs { flex-wrap: nowrap; }
    /* Bottom navigation: the five sections stay one thumb-reach away. */
    .sections {
      position: fixed;
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      justify-content: space-around;
      margin: 0;
      padding: 6px 4px calc(6px + env(safe-area-inset-bottom));
      background: var(--panel-dark);
      box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.2);
    }
    .section-btn { flex: 1 1 0; padding: 8px 4px; font-size: 0.85rem; background: transparent; border: none; color: #b8bdd1; border-radius: var(--radius-sm); }
    .section-btn[aria-current="true"] { color: #fff; background: rgba(255, 255, 255, 0.12); }
    body { padding-bottom: 64px; }
    .team-builder-grid { grid-template-columns: 1fr; }
    .team-slots { grid-template-columns: repeat(2, 1fr); }
    .team-analysis-grid, .team-analysis-columns { grid-template-columns: 1fr; }
    .grid-6xn { grid-template-columns: repeat(3, 1fr); }
    .matchup-picker-grid { grid-template-columns: 1fr; }
  }


  .compare-columns { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; margin:16px 0; }
  .compare-card, .expansion-card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-md); padding:16px; }
  .compare-card h3, .expansion-card h3 { margin-top:0; }
  .expansion-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
  .link-button { border:0; background:none; color:var(--blue); padding:0; cursor:pointer; text-decoration:underline; }
  .source-note { color:var(--muted); font-size:var(--font-sm); }
  @media (max-width:720px) { .compare-columns, .expansion-grid { grid-template-columns:1fr; } }
  footer { text-align: center; color: var(--muted); font-size: 0.8rem; padding: 24px; }

  @media (max-width: 720px) {
    main { padding: 16px; }
    .kpi-row { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .kpi-card { padding: 12px; }
    .kpi-card .value { font-size: 1.2rem; }
  }

  @media (max-width: 480px) {
    header h1 { font-size: 1.3rem; }
    .kpi-row { grid-template-columns: repeat(2, 1fr); gap: 8px; }
    .kpi-card { flex-direction: column; align-items: flex-start; gap: 6px; }
    .controls select { width: 100%; }
    section { padding: var(--space-4); }
    section h2 { margin: 0 calc(var(--space-4) * -1) var(--space-4); padding: var(--space-3) var(--space-4); }
    .grid-6xn { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 360px) {
    .kpi-row { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>
<header>
  <h1>Pokémon Champions — Analytics Dashboard</h1>
  <p>Generated {{ payload.kpis.latest_snapshot_date or "—" }} · built {{ payload.generated_at_utc }}</p>
  {# Freshness/provenance chips: which dataset version and snapshot this
     page was built from, and whether its release gates passed — visible
     without opening the Data & Sources tab. #}
  <div class="header-meta">
    <button type="button" class="header-chip theme-toggle" id="theme-toggle" aria-label="Color theme">Theme: Auto</button>
    {% if payload.kpis_by_scope %}
      {# Which regulation every figure on the page describes. static/app.js
         sets the selected option from ?reg= and reloads on change. #}
      <label class="header-chip regulation-picker">Regulation
        <select id="regulation-scope" aria-label="Regulation shown on this page">
          {% for scope in payload.kpis_by_scope %}
            {% set reg = payload.regulations | selectattr("regulation_code", "equalto", scope) | first %}
            <option value="{{ scope }}"{% if scope == payload.default_scope %} selected{% endif %}>
              {%- if reg %}{{ reg.regulation_name }}{% if scope == payload.default_scope %} (current){% endif %}{% else %}All Champions regulations{% endif -%}
            </option>
          {% endfor %}
        </select>
      </label>
    {% endif %}
    {% if payload.provenance.dataset_version %}
      <span class="header-chip">dataset {{ payload.provenance.dataset_version }}</span>
    {% endif %}
    {% if payload.kpis.latest_snapshot_date %}
      <span class="header-chip">snapshot {{ payload.kpis.latest_snapshot_date }}</span>
    {% endif %}
    {% if payload.provenance.validation_available %}
      <span class="header-chip">{% if payload.provenance.release_blocking_findings %}{{ payload.provenance.release_blocking_findings | length }} gate failure(s){% else %}all gates passing{% endif %}</span>
    {% endif %}
  </div>
</header>
{# Filled in by static/app.js (renderStalenessBanner) when the newest
   tournament is over three weeks old, or when no tournament in the data
   was played under the regulation in force today. #}
<div id="staleness-banner" class="staleness-banner" role="status" hidden></div>
<main>
  <div id="kpi-strip">
  {# One KPI row per regulation scope; app.js shows the selected one. The
     whole strip shows on the Meta section only. #}
  {% for scope, scope_kpis in (payload.kpis_by_scope or {"all": payload.kpis}).items() %}
  <div class="kpi-row" data-scope="{{ scope }}"{% if scope != (payload.default_scope or "all") %} hidden{% endif %}>
    <div class="kpi-card">
      <div class="kpi-body">
        <div class="label">Distinct Pokémon Used</div>
        <div class="value">{{ scope_kpis.distinct_pokemon_used }}</div>
      </div>
    </div>
    <div class="kpi-card">
      {% set top_used = scope_kpis.top_used_pokemon %}
      {% set top_used_art = payload.hero_art.get(top_used.pokemon_key) or payload.sprites.get(top_used.pokemon_key) if top_used %}
      {% if top_used_art %}
        <img class="kpi-sprite" src="{{ top_used_art }}" alt="" width="96" height="96" decoding="async">
      {% endif %}
      <div class="kpi-body">
        <div class="label">Most Used</div>
        <div class="value">{% if top_used %}{{ top_used.pokemon_name }}{% else %}—{% endif %}</div>
        <div class="sub">{% if top_used %}{{ top_used.usage_count }} roster appearances{% if top_used.usage_share is not none %} ({{ "%.1f"|format(top_used.usage_share * 100) }}% of meta){% endif %}{% endif %}</div>
      </div>
    </div>
    <div class="kpi-card">
      {% set top_win = scope_kpis.top_win_rate_pokemon %}
      {% set top_win_art = payload.hero_art.get(top_win.pokemon_key) or payload.sprites.get(top_win.pokemon_key) if top_win %}
      {% if top_win_art %}
        <img class="kpi-sprite" src="{{ top_win_art }}" alt="" width="96" height="96" decoding="async">
      {% endif %}
      <div class="kpi-body">
        <div class="label">Top Win Rate</div>
        <div class="value">{% if top_win %}{{ top_win.pokemon_name }}{% else %}—{% endif %}</div>
        <div class="sub">{% if top_win %}{{ "%.1f"|format(top_win.win_rate * 100) }}% ({{ top_win.record_count }} recorded matches){% endif %}</div>
      </div>
    </div>
    <div class="kpi-card">
      {% set current_reg = scope_kpis.current_regulation %}
      <div class="kpi-body">
        <div class="label">Legal Pool{% if current_reg %} · {{ current_reg.regulation_code | upper }}{% endif %}</div>
        <div class="value">{% if current_reg and current_reg.legal_pokemon_count is not none %}{{ current_reg.legal_pokemon_count }} Pokémon{% else %}—{% endif %}</div>
        <div class="sub">
          {% for r in scope_kpis.legal_pool_by_regulation %}{{ r.regulation_code | upper }} {{ r.legal_pokemon_count }}{% if not loop.last %} · {% endif %}{% endfor %}
          {% if scope_kpis.latest_snapshot_date %}<br>as of {{ scope_kpis.latest_snapshot_date }}{% endif %}
        </div>
      </div>
    </div>
  </div>
  {% endfor %}
  </div>

  {# Five sections, each with its own row of views (docs/upgrade-plan-
     2026q4.md, B2). The view buttons keep the .tab-btn/data-tab contract
     every script already uses; data-section groups them, and app.js shows
     only the active section's row. On narrow screens the section bar
     becomes a bottom navigation bar. #}
  <nav class="sections" aria-label="Sections">
    <button class="section-btn" data-section="meta" aria-current="true">Meta</button>
    <button class="section-btn" data-section="pokemon">Pokémon</button>
    <button class="section-btn" data-section="teams">Teams</button>
    <button class="section-btn" data-section="builder">Builder</button>
