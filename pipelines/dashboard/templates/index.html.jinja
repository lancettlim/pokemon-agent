  .share-controls .btn { min-height: 44px; display: inline-flex; align-items: center; }
  /* Toast (M4): one line of confirmation above the phone's bottom bar. */
  .toast { position: fixed; left: 50%; bottom: calc(76px + env(safe-area-inset-bottom, 0px)); z-index: 60; max-width: min(92vw, 420px); padding: 10px 16px; border-radius: var(--radius-pill); background: var(--panel-dark); color: #fff; font-size: var(--font-sm); font-weight: 700; box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25); transform: translate(-50%, 16px); opacity: 0; pointer-events: none; transition: opacity 0.18s, transform 0.18s; }
  .toast.is-shown { opacity: 1; transform: translate(-50%, 0); }
  @media (min-width: 721px) { .toast { bottom: 24px; } }
  @media (prefers-reduced-motion: reduce) { .toast { transition: none; } }
  .event-cards { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2) var(--space-3); margin-top: var(--space-2); }
  .event-card-pair { display: inline-flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); }
  .event-card-pair .share-controls { margin-right: 0; }
  .page-band .event-cards .btn { background: rgba(255, 255, 255, 0.12); color: #fff; border-color: rgba(255, 255, 255, 0.4); }
  .board-more a { color: var(--blue); font-weight: 700; }
  @media (max-width: 1023px) {
    .board-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); row-gap: 44px; }
    .board-band { grid-row: auto; margin: 0 0 4px; }
    .board-inner { padding-top: var(--space-4); }
    .board-art { width: 104px; height: 104px; }
  }
  @media (max-width: 720px) {
    /* Full-bleed on phones, so three tiles stay at least 104px wide at
       360px with 16px gutters and 8px gaps. */
    .board { margin-left: -16px; margin-right: -16px; padding: 8px; border-radius: 0; }
    .board-inner { padding: 8px 8px 12px; }
    .board-band { grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .board-band-block { min-height: 0; padding: var(--space-2) var(--space-3); }
    .board-band-title h3 { font-size: 1.7rem; }
    .board-band-mark { flex-direction: row; align-items: baseline; flex-wrap: wrap; gap: 4px 10px; }
    .board-band-mark strong { font-size: 1.4rem; }
    .board-controls, .board-controls .segmented { width: 100%; }
    .board-controls .segmented button { flex: 1 1 0; min-height: 44px; }
    .board-grid { gap: 36px 8px; }
  }
  @media (max-width: 480px) {
    .board-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .board-tile { min-height: 156px; }
    .board-art { width: 88px; height: 88px; margin-top: -26px; }
    /* One idea per line: the number on its own line, the types in the
       tile's top-right corner, where U9 puts them on every card. */
    .board-value-row { flex-direction: column; gap: 0; }
    .board-types { position: absolute; top: 5px; right: 5px; }
    .board-value { font-size: 1.75rem; }
    .board-name { font-size: var(--font-xs); }
    .board-form { display: block; }
  }

  /* ---------------------------------------------------------------
   * Responsive tiers (docs/upgrade-plan-2027q2.md, M2; docs/design-
   * system.md's "Responsive behavior"): phone <=480px, large phone
   * 481-720px, tablet 721-1023px, desktop >=1024px. No width from 360px
   * up scrolls the page sideways; tests/browser/test_responsive_matrix.py
   * enforces it, with 44px tap targets and 16px inputs on phones.
   * --------------------------------------------------------------- */
  /* iOS Safari zooms into any field under 16px on focus. The selector
     outranks component rules such as .combo-input's font: inherit. */
  @media (max-width: 1023px) {
    :root input:not([type="range"]):not([type="checkbox"]):not([type="radio"]),
    :root select,
    :root textarea { font-size: 16px; }
  }
  /* Every control a thumb presses is at least 44px tall on phones (U7). */
  @media (max-width: 720px) {
    .movers-toggle button, .calc-mode-btn, .type-popover-btn, .segmented button { min-height: 44px; }
  }
  /* Tablet header (finding 2): the brand loses its suffix, the five
     sections tighten and the regulation select shows only its code, so
     the bar fits from 721px instead of overflowing until about 808px. */
  @media (min-width: 721px) and (max-width: 1023px) {
    .topbar { gap: var(--space-3); padding: 0 16px; }
    .brand-sub { display: none; }
    .section-btn { padding: 6px 10px; font-size: 0.9rem; }
    .regulation-picker .reg-prefix { display: none; }
  }
  @media (max-width: 720px) {
    .regulation-picker .reg-prefix { display: none; }
  }
  /* Landscape phones: give the content its height back. */
  @media (max-height: 500px) and (orientation: landscape) {
    .tabs, .subtabs { position: static; }
  }

  @media (max-width: 480px) {
    .controls select { width: 100%; }
    section { padding: var(--space-4); }
    section h2 { margin: 0 calc(var(--space-4) * -1) var(--space-4); padding: var(--space-3) var(--space-4); }
    .grid-6xn { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
</head>
<body>
{# One sticky 56px bar (docs/upgrade-plan-2027q1.md, U2): the brand, the
   five sections, the regulation select and a ⋯ menu. The dataset version,
   snapshot and gate status moved to the footer and the Data section, so
   content starts within 200px of the top. On phones the section buttons
   become a bottom navigation bar (the .sections rules in the max-width
   720px block). #}
<header class="topbar">
  <a class="brand" href="#/overview" aria-label="Pokémon Champions data: home">Champions<span class="brand-sub"> Data</span></a>
  <nav class="sections" aria-label="Sections">
    <button type="button" class="section-btn" data-section="meta" aria-current="true">Meta</button>
    <button type="button" class="section-btn" data-section="pokemon">Pokémon</button>
    <button type="button" class="section-btn" data-section="teams">Teams</button>
    <button type="button" class="section-btn" data-section="builder">Builder</button>
    <button type="button" class="section-btn" data-section="data">Data</button>
  </nav>
  <div class="topbar-actions">
    {% if payload.kpis_by_scope %}
      {# Which regulation every figure on the page describes. static/app.js
         sets the selected option from ?reg= and reloads on change. #}
      {# Options read "M-C" so the select stays compact on tablets and phones
         (docs/upgrade-plan-2027q2.md, M3); "Reg" shows beside it on desktop. #}
      {# Population scopes ("m-c:online", docs/upgrade-plan-2027q2.md, S1)
         are picked with the Events select beside it, not listed here. #}
      {% set default_regulation = payload.default_scope.split(":")[0] %}
      <label class="regulation-picker"><span class="reg-prefix" aria-hidden="true">Reg</span>
        <select id="regulation-scope" aria-label="Regulation shown on this page">
          {% for scope in payload.scope_regulations or (payload.kpis_by_scope | list) %}
            {% set reg = payload.regulations | selectattr("regulation_code", "equalto", scope) | first %}
            <option value="{{ scope }}"{% if scope == default_regulation %} selected{% endif %}>
              {%- if reg %}{{ scope | upper }}{% else %}All{% endif -%}
            </option>
          {% endfor %}
        </select>
      </label>
      {% set populations = namespace(any=false) %}
      {% for scope in payload.kpis_by_scope if ":" in scope %}{% set populations.any = true %}{% endfor %}
      {% if populations.any %}
        {% set default_population = (payload.default_scope.split(":") + ["official"])[1] %}
        {# Official / Online / All (S1). Official stays the default; static/
           app.js disables a choice the selected regulation has no data
           for. #}
        <label class="regulation-picker population-picker">
          <select id="population-scope" aria-label="Events shown: official, online, or both">
            <option value="official"{% if default_population == "official" %} selected{% endif %}>Official</option>
            <option value="online"{% if default_population == "online" %} selected{% endif %}>Online</option>
            <option value="combined"{% if default_population == "combined" %} selected{% endif %}>All</option>
          </select>
        </label>
      {% endif %}
    {% endif %}
    <div class="more-menu">
      <button type="button" class="more-menu-btn" id="more-menu-btn" aria-haspopup="true" aria-expanded="false" aria-controls="more-menu-panel" aria-label="More options">&#8943;</button>
      <div class="more-menu-panel" id="more-menu-panel" hidden>
        <button type="button" class="theme-toggle" id="theme-toggle">Theme: Auto</button>
        <a href="#/data/how-to-read">How to read this page</a>
        <a href="#/data">Data &amp; sources</a>
      </div>
    </div>
  </div>
</header>
{# Filled in by static/app.js (renderStalenessBanner) when the newest
   tournament is over three weeks old, or when no tournament in the data
   was played under the regulation in force today. #}
<div id="staleness-banner" class="staleness-banner" role="status" hidden></div>
{# Filled in by static/app.js (renderRolloverBanner) during the first weeks
   of a new regulation, when the page opens on the previous one
   (docs/upgrade-plan-2027q1.md, U3). #}
<div id="rollover-banner" class="staleness-banner rollover-banner" role="status" hidden></div>
{# Filled in by static/app.js (renderPopulationBanner) when the page shows
   online events, alone or with official ones (docs/upgrade-plan-2027q2.md,
   S1): a different population, so every view says so. #}
<div id="population-banner" class="population-banner" role="status" hidden></div>
<nav class="tabs" role="tablist" aria-label="Views in this section">
  <button class="tab-btn" role="tab" data-section="meta" data-tab="overview" aria-selected="true">Overview</button>
  <button class="tab-btn" role="tab" data-section="meta" data-tab="tiers" aria-selected="false">Tier List</button>
  <button class="tab-btn" role="tab" data-section="meta" data-tab="usage" aria-selected="false">Usage</button>
  <button class="tab-btn" role="tab" data-section="meta" data-tab="speed-tiers" aria-selected="false">Speed Tiers</button>
  <button class="tab-btn" role="tab" data-section="pokemon" data-tab="pokemon-profile" aria-selected="false">Profile</button>
  <button class="tab-btn" role="tab" data-section="pokemon" data-tab="compare" aria-selected="false">Compare</button>
  <button class="tab-btn" role="tab" data-section="pokemon" data-tab="matchup" aria-selected="false">Matchup</button>
  <button class="tab-btn" role="tab" data-section="teams" data-tab="top-teams" aria-selected="false">Top Teams</button>
  <button class="tab-btn" role="tab" data-section="teams" data-tab="events" aria-selected="false">Events</button>
  <button class="tab-btn" role="tab" data-section="teams" data-tab="archetypes" aria-selected="false">Archetypes</button>
  <button class="tab-btn" role="tab" data-section="teams" data-tab="core-explorer" aria-selected="false">Core Explorer</button>
  <button class="tab-btn" role="tab" data-section="teams" data-tab="players" aria-selected="false">Players</button>
  <button class="tab-btn" role="tab" data-section="builder" data-tab="team-builder" aria-selected="false">Team Builder</button>
  <button class="tab-btn" role="tab" data-section="data" data-tab="data-sources" aria-selected="false">Data &amp; Sources</button>
</nav>
<main>
  <section class="tab-panel" data-panel="overview" data-section="meta">
    <h2 class="panel-title">Overview</h2>
    {# A one-time note on the change of unit (docs/upgrade-plan-2027q2.md,
       V1 and its risks), until the reader dismisses it. #}
    <p class="notice" id="team-share-notice" role="status" hidden>
      <span>Usage now counts the <strong>share of teams</strong> that brought a Pokémon, the unit the official usage card and other sites use. Every figure reads about six times the old share of roster slots, which is still in each tooltip.</span>
      <button type="button" class="btn btn-sm" id="team-share-notice-dismiss">Got it</button>
    </p>
    {# The Top 12 board (V2), the Overview's hero; app.js renders it from
       the inline KPIs, so it paints with no data fetch. #}
    <div class="board" id="top-board" role="region" aria-labelledby="board-title"></div>
    <section class="movers-panel" id="movers-panel" hidden></section>
    <div class="overview-row" id="overview-row" hidden>
      <div id="overview-latest-event"></div>
      <div id="overview-starters" class="overview-card"></div>
    </div>
  {# One KPI row per regulation scope; app.js shows the selected one. It
     sits under the Top 12 board (docs/upgrade-plan-2027q2.md, V2), which
     now leads the Overview. #}
  <div id="kpi-strip">
  {% for scope, scope_kpis in (payload.kpis_by_scope or {"all": payload.kpis}).items() %}
  <div class="kpi-row" data-scope="{{ scope }}"{% if scope != (payload.default_scope or "all") %} hidden{% endif %}>
    <div class="kpi-card">
      <div class="kpi-body">
        {% set population = scope_kpis.population or "official" %}
        <div class="label">Sample{% if population == "online" %} · online{% elif population == "combined" %} · official + online{% endif %}</div>
        <div class="value">{{ scope_kpis.event_count or 0 }} event{% if scope_kpis.event_count != 1 %}s{% endif %} · {{ "{:,}".format(scope_kpis.team_count or 0) }} teams</div>
        {% if population != "official" %}
          <div class="sub">Official events alone: {{ "{:,}".format(scope_kpis.official_team_count or 0) }} teams</div>
        {% elif scope_kpis.latest_event %}
          <div class="sub">Latest: <a href="#/event/{{ scope_kpis.latest_event.event_id }}" title="{{ scope_kpis.latest_event.event_name }}">{{ scope_kpis.latest_event.short_name }}</a>, {{ scope_kpis.latest_event.event_date }}</div>
        {% endif %}
      </div>
    </div>
    <div class="kpi-card">
      {% set top_used = scope_kpis.top_used_pokemon %}
      {% set top_used_art = payload.sprites.get(top_used.pokemon_key) if top_used %}
      {% if top_used_art %}
        <img class="kpi-sprite" src="{{ top_used_art }}" alt="" width="48" height="48" decoding="async">
      {% endif %}
      <div class="kpi-body">
        <div class="label">Most used</div>
        <div class="value">{% if top_used %}<a href="#/pokemon/{{ top_used.pokemon_key }}">{{ top_used.pokemon_name }}</a>{% else %}—{% endif %}</div>
        <div class="sub">{% if top_used %}{% if top_used.team_share is defined and top_used.team_share is not none %}On {{ "%.1f"|format(top_used.team_share * 100) }}% of teams · {% endif %}{{ "{:,}".format(top_used.usage_count) }} teams{% endif %}</div>
      </div>
    </div>
    <div class="kpi-card">
      {% set top_win = scope_kpis.top_win_rate_pokemon %}
      {% set top_win_art = payload.sprites.get(top_win.pokemon_key) if top_win %}
      {% if top_win_art %}
        <img class="kpi-sprite" src="{{ top_win_art }}" alt="" width="48" height="48" decoding="async">
      {% endif %}
      <div class="kpi-body">
        <div class="label">Top win rate</div>
        <div class="value">{% if top_win %}<a href="#/pokemon/{{ top_win.pokemon_key }}">{{ top_win.pokemon_name }}</a>{% else %}—{% endif %}</div>
        <div class="sub">{% if top_win %}{{ "%.1f"|format(top_win.win_rate * 100) }}% across {{ "{:,}".format(top_win.record_count) }} teams{% endif %}</div>
      </div>
    </div>
    <div class="kpi-card">
      {% set current_reg = scope_kpis.current_regulation %}
      <div class="kpi-body">
        <div class="label">Legal pool{% if current_reg %} · {{ current_reg.regulation_code | upper }}{% endif %}</div>
        <div class="value">{% if current_reg and current_reg.legal_pokemon_count is not none %}{{ current_reg.legal_pokemon_count }} Pokémon{% else %}—{% endif %}</div>
        <div class="sub">{% if current_reg %}{{ current_reg.start_date }} to {{ current_reg.end_date }}{% endif %}</div>
      </div>
    </div>
  </div>
  {% endfor %}
  </div>

  </section>

  <section class="tab-panel" data-panel="tiers" data-section="meta" hidden>
    <h2 class="panel-title">Tier List</h2>
    <p class="lead">Bands by share of roster slots; the chip beside each Pokémon is its win rate.</p>
    <details class="method"><summary>How this is computed</summary><p id="tiers-method"></p></details>
    <div id="tiers-body"></div>
  </section>

  <section class="tab-panel" data-panel="usage" data-section="meta" hidden>
    <h2 class="panel-title">Usage</h2>
    <p class="lead">How often each Pokémon is brought, and how its teams do, in Champions tournaments.</p>
    <details class="method"><summary>How this is computed</summary>
      <p>Every figure is computed from the team sheets of Champions-format tournaments only, never blended with standard VGC events. Usage is the share of teams that brought a Pokémon; hover a figure for its count and its share of roster slots (a team has six). The Ladder view is the exception: Showdown ladder statistics, shown beside tournament usage and never added to it.</p>
    </details>
    <div class="subtabs" role="tablist">
      <button class="subtab-btn" role="tab" data-subtab="usage-leaders" data-route="leaders" aria-selected="true">Usage</button>
      <button class="subtab-btn" role="tab" data-subtab="win-rate-leaders" data-route="win-rate" aria-selected="false">Win rate</button>
      <button class="subtab-btn" role="tab" data-subtab="usage-success" data-route="success" aria-selected="false">Success</button>
      <button class="subtab-btn" role="tab" data-subtab="usage-trends" data-route="trends" aria-selected="false">Trends</button>
      <button class="subtab-btn" role="tab" data-subtab="usage-megas" data-route="megas" aria-selected="false">Megas</button>
      <button class="subtab-btn" role="tab" data-subtab="usage-ladder" data-route="ladder" aria-selected="false">Ladder</button>
    </div>

    <div class="subtab-panel" data-subpanel="usage-leaders">
      <div class="controls">
        {# Event window (docs/upgrade-plan-2027q1.md, C4): "what changed
           since Frankfurt". #}
        <label>Events
          <select id="usage-window-filter">
            <option value="">Whole regulation</option>
          </select>
        </label>
        <label>Tier
          <select id="usage-tier-filter"></select>
        </label>
        <div class="filter-field"><span class="filter-label">Type</span>
          <div class="type-filter-row" id="usage-type-filter"></div>
        </div>
        <label>Role
          <select id="usage-role-filter">
            <option value="">All roles</option>
            <option value="physical">Physical</option>
            <option value="special">Special</option>
            <option value="mixed">Mixed</option>
          </select>
        </label>
        <label>Usage %
          <div class="range-filter">
            <input type="number" id="usage-share-min" min="0" max="100" placeholder="min" aria-label="Minimum usage %">
            <span>–</span>
            <input type="number" id="usage-share-max" min="0" max="100" placeholder="max" aria-label="Maximum usage %">
          </div>
        </label>
        <label>Speed
          <div class="range-filter">
            <input type="number" id="usage-speed-min" min="0" placeholder="min" aria-label="Minimum base Speed">
            <span>–</span>
            <input type="number" id="usage-speed-max" min="0" placeholder="max" aria-label="Maximum base Speed">
          </div>
        </label>
      </div>
      <p class="sub" id="usage-table-note"></p>
      <div id="usage-table"></div>
      <div id="usage-window-table" hidden></div>
    </div>

    <div class="subtab-panel" data-subpanel="win-rate-leaders" hidden>
      <p class="lead">Ranked by the 95% Wilson lower bound, so a small sample can't top the list on luck.</p>
      <div class="controls">
        <label>Min. teams
          <select id="win-rate-min-record-count-filter">
            <option value="5">5+</option>
            <option value="10">10+</option>
            <option value="20" selected>20+</option>
            <option value="50">50+</option>
          </select>
        </label>
      </div>
      <div id="win-rate-table"></div>
    </div>

    <div class="subtab-panel" data-subpanel="usage-success" hidden>
      <p class="lead">Popular is not the same as successful: usage weighted by where each team finished.</p>
      <details class="method"><summary>How this is computed</summary>
        <p>Raw usage counts a last-place team's roster slot exactly like a winner's. <strong>Top cut</strong> counts only appearances on a team that placed 1&#8211;8; <strong>placement-weighted</strong> weights every appearance by 1/placement, so a win counts far more than a 200th with no cutoff cliff.</p>
        <p>The <strong>Movement</strong> column is how many places a Pokémon gains or loses versus its raw usage rank. A positive number is a quiet top-cut staple; a negative one is a crowd favourite that underperforms.</p>
      </details>
      <div class="controls">
        <label>Ranked by
          <select id="usage-success-metric">
            <option value="placement_weighted">Placement-weighted</option>
            <option value="top_cut">Top cut (1&#8211;8)</option>
          </select>
        </label>
      </div>
      <div id="usage-success-table"></div>
    </div>

    <div class="subtab-panel" data-subpanel="usage-trends" hidden>
      <p class="lead">Usage at each tournament date, against the tournament date before it.</p>
      <div class="controls">
        <label>Tournament date
          <select id="usage-trend-date-filter"></select>
        </label>
      </div>
      <div id="usage-trend-table"></div>
    </div>

    {# The Mega usage panel (docs/upgrade-plan-2027q2.md, E3). #}
    <div class="subtab-panel" data-subpanel="usage-megas" hidden>
      <p class="lead">Which Mega Stones teams carry, and how many each team brings.</p>
      <p class="sub" id="usage-mega-note"></p>
      <div class="mega-panel">
        <div id="usage-mega-count"></div>
        <div id="usage-mega-table"></div>
      </div>
    </div>

    {# Ladder vs tournament (docs/upgrade-plan-2027q2.md, S2): Smogon's
       Showdown ladder statistics beside official tournament team share,
       a separate population that is never added to it. static/ladder.js
       fills it. #}
    <div class="subtab-panel" data-subpanel="usage-ladder" hidden>
      <p class="lead">What the Showdown ladder plays more, or less, than tournament players do.</p>
      <details class="method"><summary>How this is computed</summary>
        <p>Ladder usage is Smogon's monthly statistics for Pokémon Showdown's Champions ladder: each Pokémon's share of teams across every rated battle in the regulation's month. At <strong>1760+</strong> each battle is weighted by how likely its players are rated above 1760, so the strongest players count most; <strong>All ratings</strong> counts every battle the same. The month is the newest one the regulation was in force for at least half of.</p>
        <p>Tournament usage is the share of the same regulation's official tournament teams that brought it. Both are shares of teams, so they sit on one scale, but they come from different players and are never added together. Credit: Smogon University and Pokémon Showdown.</p>
      </details>
      <div class="controls" id="ladder-controls"></div>
      <p class="sub" id="ladder-note"></p>
      <figure class="ladder-figure" id="ladder-scatter"></figure>
      <div class="ladder-lists" id="ladder-lists"></div>
    </div>
  </section>

  <section class="tab-panel" data-panel="pokemon-profile" data-section="pokemon" hidden>
    <h2 class="panel-title">Pokémon Profile</h2>
    <div class="controls profile-controls">
      <label>Pokémon
        <select id="pokemon-profile-filter"></select>
      </label>
      {# Recently viewed, per browser (docs/upgrade-plan-2027q1.md, P2). #}
      <div class="recent-strip" id="profile-recent" hidden></div>
    </div>

    <div class="profile-layout">
      <div id="pokemon-profile-stats" class="empty-state"></div>
      <div id="pokemon-profile-set"></div>
    </div>

    <div class="subtabs" role="tablist">
      <button class="subtab-btn" role="tab" data-subtab="profile-items" data-route="items" aria-selected="true">Items</button>
      <button class="subtab-btn" role="tab" data-subtab="profile-ability" data-route="abilities">Ability</button>
      <button class="subtab-btn" role="tab" data-subtab="profile-moves" data-route="moves">Moves</button>
      <button class="subtab-btn" role="tab" data-subtab="profile-team-cores" data-route="cores">Teammates</button>
