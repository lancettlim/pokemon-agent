  .board-tile:hover, .board-tile:focus-visible { box-shadow: 0 0 0 3px var(--board-gold); }
  /* Hero art breaks the tile's top edge, as on the official card. */
  .board-art { width: 112px; height: 112px; margin-top: -34px; object-fit: contain; filter: drop-shadow(0 4px 5px rgba(0, 0, 0, 0.35)); }
  .board-art-blank { display: block; width: 112px; height: 78px; }
