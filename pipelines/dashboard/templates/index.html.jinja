<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pokémon Champions — Analytics Dashboard</title>
{# No favicon file to fetch: an inline one keeps the console free of 404s. #}
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Ccircle cx='8' cy='8' r='7' fill='%23e3323c'/%3E%3Crect y='7' width='16' height='2' fill='%2312131a'/%3E%3Ccircle cx='8' cy='8' r='2.5' fill='%23fff' stroke='%2312131a'/%3E%3C/svg%3E">
<script>
  // Apply a saved Light/Dark choice before first paint (no flash of the
  // wrong theme). "auto" or nothing saved follows prefers-color-scheme.
  try {
    var savedTheme = localStorage.getItem("dashboard-theme");
    if (savedTheme === "light" || savedTheme === "dark") {
      document.documentElement.setAttribute("data-theme", savedTheme);
    }
  } catch (e) {}
</script>
<style>
  /* ---------------------------------------------------------------
   * Design tokens — see docs/design-system.md for the full token
   * reference, component catalog, and Pokémon-representation/naming
   * conventions this dashboard follows. Every color, spacing, and
   * radius value used below traces back to one of these variables so
   * the two stay in sync.
   * --------------------------------------------------------------- */
  :root {
    /* Color */
    --navy: #16264d;
    --blue: #2b5cad;
    --light-blue: #eaf1fb;
    --border: #16264d;
    --muted: #5b6b8c;
    --bg: #f4f6fb;
    --surface: #fff;
    --positive: #1f8a4c;
    --positive-bg: #e8f7ee;
    --warning: #a8710a;
    --warning-bg: #fbf1e0;
    --danger: #b23434;
    --danger-bg: #fbe9e9;

    /* Broadcast/esports theme tokens (docs/design-system.md's "Broadcast
       color-block header" component) — color-blocking + weight/case is
       what gives this a broadcast-graphic feel, deliberately without
       adding a webfont dependency. */
    --panel-dark: #12131a;
    --accent-red: #e3323c;
    --accent-red-bg: #fce7e8;
    --accent-gold: #f4b942;
    --accent-gold-bg: #fdf3dd;

    /* Icon-size scale (docs/design-system.md's "Icon size scale") — every
       sprite/item/type icon must use one of these three tokens, no other
       pixel value, replacing four previously ad-hoc sizes (40/32/24/22px).
       --icon-xl is a deliberate 4th tier, reserved for the Pokémon Profile
       header's dual-type badge (a new, hero-level piece of information —
       see "Larger type badge" in docs/design-system.md). */
    --icon-sm: 40px;
    --icon-md: 64px;
    --icon-lg: 96px;
    --icon-xl: 128px;

    /* Per-type accent colors (docs/design-system.md's "Type color
       accents"). Emitted from pipelines/render/template.py's TYPE_COLORS
       via build.py's _type_colors() rather than hardcoded here, so the
       dashboard and the team-card renderer share one palette. Used as
       accents (borders, gradients) rather than fills — the broadcast
       palette above stays the page's identity. */
    {%- for type_name, hex in payload.type_colors.items() | sort %}
    --type-{{ type_name }}: {{ hex }};
    {%- endfor %}
    --type-unknown: #6B7280;

    /* Speed-tier badge scale (docs/design-system.md's "Speed-tier badge"
       component) — bucketed off pokemon_champions_profile.speed. */
    --speed-blazing: #b23434;
    --speed-blazing-bg: #fbe9e9;
    --speed-fast: #a8710a;
    --speed-fast-bg: #fbf1e0;
    --speed-average: #2b5cad;
    --speed-average-bg: #eaf1fb;
    --speed-slow: #5b6b8c;
    --speed-slow-bg: #eef0f5;

    /* Spacing scale (4px base unit) */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 20px;
    --space-6: 24px;
    --space-8: 32px;

    /* Radius scale */
    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-pill: 999px;

    /* Type scale */
    --font-xs: 0.8rem;
    --font-sm: 0.85rem;
    --font-base: 0.9rem;
    --font-md: 0.95rem;
    --font-lg: 1.1rem;
    --font-xl: 1.5rem;
    --font-2xl: 1.6rem;
  }
  * { box-sizing: border-box; }
  /* Dark theme (docs/upgrade-plan-2026q4.md, B8): the same tokens, redefined.
     Follows the OS setting unless the header toggle pinned Light or Dark
     (data-theme on <html>). Type colors stay as they are: they're accents
     on borders and pills and read on both backgrounds. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --navy: #e6e9f2;
      --blue: #6c9bef;
      --light-blue: #1f2a40;
      --border: #3a4560;
      --muted: #9aa6c2;
      --bg: #0f1218;
      --surface: #181c25;
      --positive: #4fc27f;
      --positive-bg: #12301f;
      --warning: #e0a94a;
      --warning-bg: #33280f;
      --danger: #ef6b6b;
      --danger-bg: #3a1717;
      --panel-dark: #07080c;
      --accent-red-bg: #3a1a1d;
      --accent-gold-bg: #3a2f12;
      --speed-blazing: #ef6b6b;
      --speed-blazing-bg: #3a1717;
      --speed-fast: #e0a94a;
      --speed-fast-bg: #33280f;
      --speed-average: #6c9bef;
      --speed-average-bg: #1f2a40;
      --speed-slow: #9aa6c2;
      --speed-slow-bg: #252b38;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --navy: #e6e9f2;
    --blue: #6c9bef;
    --light-blue: #1f2a40;
    --border: #3a4560;
    --muted: #9aa6c2;
    --bg: #0f1218;
    --surface: #181c25;
    --positive: #4fc27f;
    --positive-bg: #12301f;
    --warning: #e0a94a;
    --warning-bg: #33280f;
    --danger: #ef6b6b;
    --danger-bg: #3a1717;
    --panel-dark: #07080c;
    --accent-red-bg: #3a1a1d;
    --accent-gold-bg: #3a2f12;
    --speed-blazing: #ef6b6b;
    --speed-blazing-bg: #3a1717;
    --speed-fast: #e0a94a;
    --speed-fast-bg: #33280f;
    --speed-average: #6c9bef;
    --speed-average-bg: #1f2a40;
    --speed-slow: #9aa6c2;
    --speed-slow-bg: #252b38;
    color-scheme: dark;
  }

  /* Keyboard focus is always visible; motion is cut for those who ask. */
  :focus-visible { outline: 3px solid var(--blue); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
  }

  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: var(--bg);
    color: var(--navy);
  }
  /* One sticky 56px bar (docs/upgrade-plan-2027q1.md, U2). */
  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    height: 56px;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: 0 max(16px, calc((100vw - 1100px) / 2 + 24px));
    background: var(--panel-dark);
    color: #fff;
  }
  .brand {
    flex: 0 0 auto;
    color: #fff;
    text-decoration: none;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .brand-sub { color: var(--accent-gold); }
  .topbar-actions { margin-left: auto; display: flex; align-items: center; gap: var(--space-2); }
  .more-menu { position: relative; }
  .more-menu-btn {
    min-width: 44px;
    min-height: 40px;
    font: inherit;
    font-size: 1.3rem;
    line-height: 1;
    color: #fff;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .more-menu-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    min-width: 220px;
    padding: var(--space-1);
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.2);
  }
  .more-menu-panel[hidden] { display: none; }
  .more-menu-panel a, .more-menu-panel button {
    display: block;
    width: 100%;
    min-height: 44px;
    padding: 10px 12px;
    text-align: left;
    font: inherit;
    color: var(--navy);
    background: none;
    border: 0;
    border-radius: var(--radius-sm);
    text-decoration: none;
    cursor: pointer;
  }
  .more-menu-panel a:hover, .more-menu-panel button:hover { background: var(--light-blue); }
  main { max-width: 1100px; margin: 0 auto; padding: var(--space-4) 24px 24px; }
  a { color: var(--blue); }
  /* Pokémon names and sprites are real links (U1), styled as the text they
     replace. */
  a.pokemon-link, a.grid-6xn-tile, a.tier-chip, a.mover-link, a.team-comp-slot { color: inherit; text-decoration: none; }
  a.pokemon-link:hover span, a.mover-link:hover .mover-name { text-decoration: underline; }
  /* "How this is computed": the intro line stays one sentence; the method
     sits behind a disclosure (U2). */
  .method { margin: 0 0 var(--space-4); font-size: var(--font-sm); color: var(--muted); }
  .method summary { cursor: pointer; font-weight: 600; color: var(--blue); }
  .method[open] summary { margin-bottom: var(--space-2); }
  .method p { margin: 0 0 var(--space-2); }
  /* Components that set their own display (grid/flex) would otherwise
     override the hidden attribute app.js toggles. */
  .kpi-row[hidden], .movers-panel[hidden] { display: none; }
  /* ---------------------------------------------------------------
   * 2027 Q1 components (docs/upgrade-plan-2027q1.md). See
   * docs/design-system.md for the component reference.
   * --------------------------------------------------------------- */
  /* Shared data table (app.js createDataTable, U5). The panel clips rather
     than hides overflow, so the header can stick under the 56px bar. */
  .data-table-host { margin-bottom: var(--space-4); }
  .data-table { width: 100%; border-collapse: separate; border-spacing: 0; font-size: var(--font-base); }
  .data-table th {
    position: sticky;
    top: 56px;
    z-index: 5;
    background: var(--surface);
    border-bottom: 2px solid var(--border);
    text-align: left;
    white-space: nowrap;
  }
  .data-table th.sortable { cursor: pointer; user-select: none; }
  .data-table th.sortable:hover { color: var(--navy); }
  .data-table th[aria-sort="ascending"]::after { content: " ▲"; color: var(--accent-red); }
  .data-table th[aria-sort="descending"]::after { content: " ▼"; color: var(--accent-red); }
  .data-table td { border-bottom: 1px solid var(--light-blue); vertical-align: middle; }
  .data-table .num { text-align: right; font-variant-numeric: tabular-nums; }
  .data-table tr.row-link { cursor: pointer; }
  .data-table tr.row-link:hover td { background: var(--light-blue); }
  .data-table .cell-icon { width: 32px; height: 32px; }
  .data-table-sort { display: none; }
  .data-table-more { margin-top: var(--space-2); }
  .share-cell { display: inline-grid; grid-template-columns: 64px 3.6em; align-items: center; gap: 6px; }
  .share-bar { height: 8px; border-radius: 999px; background: var(--blue); justify-self: start; }
  .share-value { text-align: right; }
  .data-table th, .data-table td { padding: 4px 10px; }
  .data-table .team-comp { justify-content: flex-start; }
  .core-names { display: block; font-size: var(--font-xs); margin-top: 2px; }
  .core-names a { color: inherit; }
  @media (max-width: 600px) {
    /* Two-line rows on phones: "main" columns on line one, the rest as
       labelled details on line two. */
    .data-table thead { display: none; }
    .data-table, .data-table tbody { display: block; }
    .data-table tr { display: flex; flex-wrap: wrap; align-items: center; gap: 2px 8px; padding: 8px 0; border-bottom: 1px solid var(--light-blue); }
    .data-table tr::after { content: ""; order: 1; flex-basis: 100%; height: 0; }
    .data-table td { border: 0; padding: 0; white-space: normal; }
    .data-table td.col-main { order: 0; }
    .data-table td.col-main:nth-child(2) { flex: 1 1 auto; min-width: 0; }
    .data-table td.col-detail { order: 2; font-size: var(--font-xs); color: var(--muted); }
    .data-table td.col-detail::before { content: attr(data-label) " "; font-weight: 600; }
    .data-table td.col-phone-hide { display: none; }
    .data-table td.num { text-align: left; }
    .data-table-sort { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--font-sm); color: var(--muted); margin-bottom: var(--space-2); }
    .share-cell { grid-template-columns: 40px 3.6em; }
  }
  /* Tooltip (app.js tipHtml / [data-tip]). */
  .tip {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    margin-left: 4px;
    padding: 0;
    border: 1px solid var(--muted);
    border-radius: 50%;
    background: var(--surface);
    color: var(--muted);
    font: italic 700 12px/1 Georgia, serif;
    cursor: help;
    flex: 0 0 auto;
  }
  .tip-bubble {
    position: absolute;
    z-index: 60;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    background: var(--panel-dark);
    color: #fff;
    font-size: var(--font-sm);
    line-height: 1.35;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
    pointer-events: none;
  }
  .tip-bubble[hidden] { display: none; }
  /* Real-set card (app.js setCardHtml, P1). */
  .set-card { border: 2px solid var(--border); border-radius: 10px; padding: var(--space-4); background: var(--surface); }
  .set-card-head { display: flex; justify-content: space-between; align-items: center; gap: var(--space-2); }
  .set-card h3 { margin: 0; font-size: 1rem; }
  .set-level { display: inline-flex; border: 1px solid var(--border); border-radius: var(--radius-pill); overflow: hidden; }
  .set-level-btn { font: inherit; font-size: var(--font-xs); font-weight: 700; padding: 4px 12px; border: 0; background: var(--surface); color: var(--muted); cursor: pointer; min-height: 32px; }
  .set-level-btn[aria-pressed="true"] { background: var(--blue); color: #fff; }
  .set-tabs { display: flex; gap: var(--space-1); margin: var(--space-3) 0 var(--space-2); overflow-x: auto; }
  .set-tab { font: inherit; font-size: var(--font-sm); font-weight: 600; padding: 6px 12px; border-radius: var(--radius-pill); border: 0; background: var(--light-blue); color: var(--muted); cursor: pointer; white-space: nowrap; min-height: 36px; }
  .set-tab[aria-selected="true"] { background: var(--panel-dark); color: #fff; }
  .set-tab[aria-selected="true"] .set-share { color: #d7dbe8; }
  .set-body dl { display: grid; grid-template-columns: auto 1fr; gap: 4px var(--space-3); margin: var(--space-2) 0; align-items: center; }
  .set-body dt { color: var(--muted); font-weight: 600; }
  .set-body dd { margin: 0; font-weight: 600; }
  .set-body .cell-icon { width: 28px; height: 28px; }
  .set-flex { color: var(--muted); font-style: italic; }
  .set-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; margin-top: var(--space-2); }
  a.btn { text-decoration: none; display: inline-flex; align-items: center; }
  textarea.copy-fallback { flex-basis: 100%; width: 100%; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: var(--font-xs); }
  /* Type filter popover (app.js renderTypeFilterChips, U6). */
  .filter-field { display: flex; flex-direction: column; gap: 4px; font-size: 0.85rem; color: var(--muted); }
  .type-popover { position: relative; }
  .type-popover-btn { font: inherit; font-size: 16px; min-height: 36px; padding: 4px 10px; border-radius: 6px; border: 1px solid var(--border); background: var(--surface); color: var(--navy); cursor: pointer; white-space: nowrap; }
  .type-popover-btn.is-active { border-color: var(--blue); background: var(--light-blue); font-weight: 700; }
  .type-popover-panel {
    position: absolute;
    z-index: 30;
    top: calc(100% + 6px);
    left: 0;
    width: min(340px, calc(100vw - 32px));
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    padding: var(--space-2);
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18);
  }
  .type-popover-panel[hidden] { display: none; }
  .type-popover-panel .type-filter-chip { display: flex; align-items: center; gap: 6px; border-radius: var(--radius-sm); padding: 4px 6px; min-height: 44px; color: var(--navy); font: inherit; font-size: var(--font-xs); text-transform: capitalize; }
  .type-popover-panel .type-filter-chip[aria-pressed="true"] { background: var(--light-blue); border-color: var(--blue); }
  .type-popover-panel.has-selection .type-filter-chip[aria-pressed="false"] { opacity: 0.5; }
  .type-popover-clear { grid-column: 1 / -1; justify-self: end; }
  /* Scroll cues for horizontally scrolling tab rows (U7). */
  .tabs, .subtabs { position: relative; }
  .scroll-cues.can-scroll-right { -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 32px), transparent); mask-image: linear-gradient(to right, #000 calc(100% - 32px), transparent); }
  .scroll-cues.can-scroll-left { -webkit-mask-image: linear-gradient(to right, transparent, #000 32px); mask-image: linear-gradient(to right, transparent, #000 32px); }
  .scroll-cues.can-scroll-left.can-scroll-right { -webkit-mask-image: linear-gradient(to right, transparent, #000 32px, #000 calc(100% - 32px), transparent); mask-image: linear-gradient(to right, transparent, #000 32px, #000 calc(100% - 32px), transparent); }
  @media (max-width: 720px) {
    .tabs, .subtabs { flex-wrap: nowrap; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; }
    .tabs::-webkit-scrollbar, .subtabs::-webkit-scrollbar { display: none; }
    .tab-btn, .subtab-btn { scroll-snap-align: start; min-height: 44px; }
    .tier-chip, .toggle-chip, .set-tab, .set-level-btn { min-height: 44px; }
  }
  /* Team cards (app.js teamCardHtml, C1/C2/P5): placement and record as
     the headline, then who and where, the six Pokémon, sets and actions. */
  .team-card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: var(--space-3); margin-bottom: var(--space-5); }
  .team-card { border: 2px solid var(--border); border-radius: var(--radius-md); padding: var(--space-3); background: var(--surface); display: flex; flex-direction: column; gap: var(--space-2); min-width: 0; }
  .team-card-head { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-2); }
  .team-card-headline { font-size: var(--font-lg); font-weight: 800; }
  .team-card-record { color: var(--accent-red); }
  .team-card-wr { font-size: var(--font-xs); color: var(--muted); font-weight: 600; white-space: nowrap; }
  .team-card-who { font-size: var(--font-sm); color: var(--muted); }
  .team-card-who a { color: var(--navy); font-weight: 600; }
  .team-card .team-comp { justify-content: flex-start; }
  .team-card-sets summary { cursor: pointer; font-size: var(--font-sm); font-weight: 600; color: var(--blue); }
  .team-card-sets ul { list-style: none; margin: var(--space-2) 0 0; padding: 0; display: grid; gap: 6px; font-size: var(--font-sm); }
  .team-card-sets a { font-weight: 700; color: var(--navy); }
  .team-card-set-detail { display: block; color: var(--muted); font-size: var(--font-xs); }
  .team-card-actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: auto; }
  .eyebrow { margin: 0; font-size: var(--font-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
  .eyebrow a { color: inherit; }
  section h2.event-title { margin: var(--space-1) 0; padding: 0; background: none; color: var(--navy); font-size: var(--font-xl); text-transform: none; letter-spacing: 0; }
  .event-meta { margin: 0 0 var(--space-1); font-weight: 600; }
  .performer-columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); }
  .performer-columns h4 { margin: 0 0 var(--space-2); }
  .performer-columns[hidden] { display: none; }
  .winner-cell { display: inline-flex; align-items: center; gap: var(--space-2); }
  .winner-cell .team-comp { flex-wrap: nowrap; gap: 0; }
  /* Overview: latest event + "Copy and play" (C1, P5). */
  .overview-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: var(--space-4); margin-bottom: var(--space-5); }
  .overview-row[hidden] { display: none; }
  .latest-event { border: 2px solid var(--border); border-radius: var(--radius-md); padding: var(--space-4); height: 100%; }
  .latest-event h3 { margin: var(--space-1) 0; font-size: 1.05rem; text-transform: none; letter-spacing: 0; color: var(--navy); }
  .latest-event h3 a { color: inherit; }
  .latest-event .team-comp { justify-content: flex-start; margin: var(--space-2) 0; }
  .starter-strip { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: var(--space-3); }
  .starter-strip .team-comp-slot img { width: 32px; height: 32px; }
  @media (max-width: 900px) {
    .overview-row, .performer-columns { grid-template-columns: 1fr; }
  }
  .builder-notice { background: var(--positive-bg); color: var(--positive); border-radius: var(--radius-sm); padding: var(--space-2) var(--space-3); font-weight: 600; }
  .builder-notice[hidden] { display: none; }
  /* Team Builder suggested partners (teams.js renderSuggestions). */
  .suggestion-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: var(--space-2); margin-bottom: var(--space-4); }
  .suggestion { display: flex; align-items: center; gap: var(--space-2); border: 2px solid var(--border); border-radius: 10px; padding: var(--space-2); background: var(--surface); }
  .suggestion-body { flex: 1; min-width: 0; }
  .suggestion-body strong { display: block; }
  .suggestion-body small { color: var(--muted); }
  /* Tier List (app.js setupTiers): usage bands, win-rate chip per Pokémon. */
  .tier-row { display: grid; grid-template-columns: 64px 1fr; gap: var(--space-3); align-items: stretch; margin-bottom: var(--space-3); }
  .tier-label { display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 10px; color: #fff; font-weight: 800; font-size: 1.6rem; line-height: 1; }
  .tier-label small { font-size: 0.65rem; font-weight: 600; margin-top: 4px; opacity: 0.9; }
  .tier-s { background: var(--accent-red); }
  .tier-a { background: #e8622c; }
  .tier-b { background: var(--accent-gold); color: var(--navy); }
  .tier-c { background: var(--muted); }
  .tier-members { display: flex; flex-wrap: wrap; gap: var(--space-2); border: 2px solid var(--border); border-radius: 10px; padding: var(--space-2); }
  .tier-chip { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px 4px 4px; border-radius: 999px; background: var(--light-blue); font-weight: 600; font-size: 0.9rem; border: 0; cursor: pointer; font-family: inherit; color: var(--navy); }
  .tier-chip:hover { outline: 2px solid var(--blue); }
  .tier-wr { font-size: 0.75rem; font-weight: 700; padding: 1px 6px; border-radius: 999px; background: var(--surface); color: var(--muted); }
  .tier-wr.is-strong { color: var(--positive); }
  .tier-wr.is-weak { color: var(--danger); }
  /* Pokémon Profile: stat bars against the format median, and the
     most-common-set card beside them (app.js statBarsHtml/commonSetHtml). */
  .profile-layout { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 2fr); gap: var(--space-5); align-items: start; margin-bottom: var(--space-5); }
  .profile-usage-line { margin: var(--space-1) 0 var(--space-3); color: var(--muted); }
  .stat-bars { min-width: 260px; }
  .stat-bar-row { display: grid; grid-template-columns: 2.5em 2.5em 1fr; align-items: center; gap: var(--space-2); margin: 3px 0; font-variant-numeric: tabular-nums; }
  .stat-label { color: var(--muted); font-weight: 600; font-size: 0.85rem; }
  .stat-value { font-weight: 700; text-align: right; }
  .stat-track { position: relative; height: 10px; background: var(--light-blue); border-radius: 999px; }
  .stat-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 999px; background: var(--blue); }
  .stat-fill.is-high { background: var(--positive); }
  .stat-fill.is-low { background: var(--warning); }
  .stat-median { position: absolute; top: -3px; bottom: -3px; width: 2px; background: var(--navy); }
  .stat-legend { font-size: 0.8rem; color: var(--muted); margin: var(--space-2) 0 0; }
  .common-set { border: 2px solid var(--border); border-radius: 10px; padding: var(--space-4); background: var(--surface); }
  .common-set-head { display: flex; justify-content: space-between; align-items: center; gap: var(--space-2); }
  .common-set h3 { margin: 0; font-size: 1rem; }
  .common-set dl { display: grid; grid-template-columns: auto 1fr; gap: 4px var(--space-3); margin: var(--space-3) 0; }
  .common-set dt { color: var(--muted); font-weight: 600; }
  .common-set dd { margin: 0; font-weight: 600; }
  .set-moves { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 4px var(--space-3); }
  .set-sample { font-size: 0.85rem; color: var(--muted); margin: 0 0 var(--space-2); }
  .set-sample.is-thin { color: var(--warning); font-weight: 600; }
  .set-share { color: var(--muted); font-weight: 400; font-size: 0.85rem; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 720px) { .profile-layout { grid-template-columns: 1fr; } }
  /* Phones: the bar keeps the brand, the regulation select and the ⋯ menu. */
  @media (max-width: 480px) {
    .brand-sub { display: none; }
    .kpi-card .kpi-sprite { display: none; }
    .kpi-card .sub { display: none; }
    .kpi-card .value { font-size: 0.95rem; }
  }
  /* Pokémon search combobox (app.js attachPokemonCombobox). The original
     <select> stays in the DOM as the source of truth, visually hidden. */
  .combo { position: relative; display: inline-block; min-width: 240px; }
  .combo-input {
    width: 100%;
    font: inherit;
    padding: 8px 10px;
    border: 2px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .combo-input:focus { outline: 3px solid var(--blue); outline-offset: 1px; }
  .combo-list {
    position: absolute;
    z-index: 30;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    max-height: 360px;
    overflow-y: auto;
    margin: 0;
    padding: 4px;
    list-style: none;
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: var(--radius-sm);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
  }
  .combo-list li { display: flex; align-items: center; gap: var(--space-2); padding: 4px 8px; border-radius: var(--radius-sm); cursor: pointer; }
  .combo-list li[aria-selected="true"] { background: var(--light-blue); }
  .combo-list .combo-empty { color: var(--muted); cursor: default; }
  .combo-list[hidden] { display: none; }
  .combo-source { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .theme-toggle { font: inherit; cursor: pointer; background: transparent; color: inherit; }
  .regulation-picker { display: inline-flex; align-items: center; }
  .regulation-picker select {
    min-height: 40px;
    font: inherit;
    font-weight: 700;
    color: var(--navy);
    background: var(--surface);
    border-radius: var(--radius-sm);
    border: 1px solid #b8bdd1;
    padding: 4px 8px;
  }
  .movers-panel {
    border: 2px solid var(--border);
    border-radius: 10px;
    padding: var(--space-4) var(--space-5);
    margin-bottom: var(--space-5);
  }
  .movers-panel h3 { margin: 0 0 var(--space-1); }
  .movers-panel h4 { margin: var(--space-3) 0 var(--space-2); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.03em; color: var(--muted); }
  .mover-columns { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-4); }
  .mover-list { list-style: none; margin: 0; padding: 0; }
  .mover-list li { padding: 2px 0; }
  .mover-list .mover-link { display: flex; align-items: center; gap: var(--space-2); }
  .mover-name { flex: 1; font-weight: 600; min-width: 0; }
  .mover-share { color: var(--muted); font-variant-numeric: tabular-nums; }
  .mover-delta { font-weight: 700; font-variant-numeric: tabular-nums; min-width: 5.5em; text-align: right; }
  .mover-delta.is-up { color: var(--positive); }
  .mover-delta.is-down { color: var(--danger); }
  .staleness-banner {
    background: var(--warning-bg);
    color: var(--warning);
    border-bottom: 2px solid var(--warning);
    padding: var(--space-3) var(--space-5);
    text-align: center;
    font-weight: 600;
  }

  /* Compact KPI strip (U2): one ~70px row, so content starts within 200px. */
  .kpi-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .kpi-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
  }
  .kpi-card .kpi-sprite { width: 48px; height: 48px; object-fit: contain; flex: 0 0 auto; }
  .kpi-card .kpi-body { min-width: 0; }
  .kpi-card .label { font-size: 0.72rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.03em; }
  /* Names wrap only between words ("Mega Charizard Y"); break-word used to
     split long single-word names mid-word. */
  .kpi-card .value { font-size: 1.05rem; line-height: 1.2; font-weight: 700; margin-top: 2px; overflow-wrap: normal; word-break: normal; }
  .kpi-card .value a { color: inherit; text-decoration: none; }
  .kpi-card .sub { font-size: 0.78rem; color: var(--muted); margin-top: 1px; }

  /* --- Tabs --- */
  /* Wraps onto a second row on wide screens, so no tab is ever clipped
     off the right edge with no hint that it exists. Narrow screens keep
     the single scrollable row (see the max-width:720px block). */
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
    border-bottom: 2px solid var(--border);
    background: var(--bg);
  }
  .sections { display: flex; gap: var(--space-1); }
  .section-btn {
    flex: 0 0 auto;
    min-height: 40px;
    font: inherit;
    font-weight: 700;
    font-size: 0.95rem;
    color: #b8bdd1;
    background: transparent;
    border: 0;
    border-radius: var(--radius-sm);
    padding: 6px 14px;
    cursor: pointer;
  }
  .section-btn:hover { color: #fff; }
  .section-btn[aria-current="true"] { color: #fff; background: rgba(255, 255, 255, 0.14); }
  .tab-btn[hidden], .tabs[hidden], #kpi-strip[hidden] { display: none; }
  .tab-btn {
    flex: 0 0 auto;
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 600;
    padding: 10px 16px;
    cursor: pointer;
    white-space: nowrap;
  }
  .tab-btn:hover { color: var(--navy); }
  .tab-btn[aria-selected="true"] {
    color: var(--accent-red);
    border-bottom-color: var(--accent-red);
  }
  .tab-panel[hidden] { display: none; }

  /* --- Sub-tabs: a compact pill row nested inside one top-level tab/
     section (e.g. Usage's leaderboards, Pokémon Profile's Items/Ability/
     Moves/Team Cores), so several equally-important views can share one
     section instead of stacking. Deliberately visually lighter than the
     top-level `.tabs` row above, which stays reserved for the page's
     ten main tabs. --- */
  .subtabs {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }
  .subtab-btn {
    flex: 0 0 auto;
    background: var(--light-blue);
    border: none;
    border-radius: var(--radius-pill);
    color: var(--muted);
    font-size: var(--font-sm);
    font-weight: 600;
    padding: 6px 14px;
    cursor: pointer;
    white-space: nowrap;
  }
  .subtab-btn:hover { color: var(--navy); }
  .subtab-btn[aria-selected="true"] { background: var(--blue); color: #fff; }
  .subtab-panel[hidden] { display: none; }

  section {
    background: var(--surface);
    border: 2px solid var(--border);
    border-radius: 10px;
    padding: var(--space-5) var(--space-6) var(--space-6);
    margin-bottom: var(--space-6);
    overflow: hidden;
    overflow: clip;
  }
  /* A panel's own title repeats the tab label right above it, so it is
     kept for screen readers only (U2). */
  .tab-panel > h2.panel-title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; margin: 0; padding: 0; }
  .lead { margin: 0 0 var(--space-2); color: var(--muted); }
  /* Broadcast color-block section header (docs/design-system.md) — bold,
     uppercase, letter-spaced, on a dark bar, replacing plain
     text-on-white section titles. */
  section h2 {
    margin: 0 calc(var(--space-8) * -1) var(--space-4);
    padding: var(--space-4) var(--space-8);
    background: var(--panel-dark);
    color: #fff;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 800;
  }
  section h3 { font-size: var(--font-md); text-transform: uppercase; letter-spacing: 0.03em; color: var(--muted); }
  .controls { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; align-items: flex-end; }
  .controls label { font-size: 0.85rem; color: var(--muted); display: flex; flex-direction: column; gap: 4px; }
  select {
    padding: 6px 8px;
    border-radius: 6px;
    border: 1px solid var(--border);
    font-size: 16px; /* prevents iOS Safari auto-zoom-on-focus */
  }
  /* Range filter (min/max pair — stat-range, usage/win-rate range) */
  .range-filter { display: flex; align-items: center; gap: 4px; }
  .range-filter input[type="number"] {
    width: 4.5em;
    padding: 6px 8px;
    border-radius: 6px;
    border: 1px solid var(--border);
    font-size: 16px;
  }
  /* Nine 40px icon buttons a row, so the 18 types sit in two even rows. */
  .type-filter-row { display: flex; flex-wrap: wrap; gap: 6px; max-width: 408px; }

  .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  th, td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--light-blue); white-space: nowrap; }
  th { color: var(--muted); font-weight: 600; }
  th.sortable { cursor: pointer; user-select: none; }
  th.sortable:hover { color: var(--navy); }
  th.sortable .sort-indicator { margin-left: 4px; color: var(--accent-red); }

  /* Sprite/icon cells populated by app.js's pokemonCell()/iconCell() helpers */
  .cell-with-icon { display: flex; align-items: center; gap: 8px; }
  .cell-icon { width: var(--icon-sm); height: var(--icon-sm); object-fit: contain; flex: 0 0 auto; }

  /* Small muted annotation next to a value (Win rate leaders table's
     "(n=X)" sample-size note — see "Percentages, not raw counts" in
     docs/design-system.md). */
  .ranked-value { color: var(--muted); font-weight: 700; white-space: nowrap; }

  /* --- 6-wide grid (docs/design-system.md's "3-tier tab layout
     convention" tier 2, and the ".grid-6xn component"): the dashboard's
     one component for any usage/win-rate metric and for a spotlight
     grid of Pokémon (Overview's Top 12), replacing the old ranked-list
     bars and the separate spotlight-grid/spotlight-card pattern. Fixed 6
     columns on desktop (not auto-fill/auto-fit — a deliberately denser,
     more uniform grid), collapsing to 3 columns at 720px and 2 at 480px
     per the existing breakpoint convention. Each tile bolds its headline
     percentage (.grid-6xn-value) per the "bold the percentage" ask. */
  .grid-6xn { display: grid; grid-template-columns: repeat(6, 1fr); gap: var(--space-3); }
  .grid-6xn-tile {
    border: 2px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-1);
    position: relative;
  }
  .grid-6xn-tile.is-leader { border-color: var(--accent-red); background: var(--accent-red-bg); }

  /* Type color accent (docs/design-system.md's "Type color accents"): a
     left-edge bar in the Pokémon's own type colors, painted from the
     --tile-accent custom property app.js sets per element. An accent, not
     a fill — the broadcast palette stays the page's identity, and the
     .is-leader treatment above still reads over the top of it. */
  .has-type-accent { position: relative; overflow: hidden; }
  .has-type-accent::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 6px;
    background: var(--tile-accent, var(--type-unknown));
  }

  /* A team drawn as its six Pokémon (app.js's teamCompositionHtml). Wraps
     to two rows at narrow widths rather than overflowing its tile. */
  .team-comp {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1);
  }
  .team-comp-slot { display: inline-flex; align-items: center; }
  .team-comp-slot img { display: block; }
  /* Placeholder for a roster slot whose sprite didn't resolve, so a
     six-Pokémon team still reads as six. */
  .team-comp-blank {
    display: inline-block;
    width: var(--icon-sm);
    height: var(--icon-sm);
    border-radius: 50%;
    background: var(--light-blue);
  }

  /* Hero art (pokemon_asset's home_render kind) is a transparent-background
     render, drawn at --icon-lg/--icon-xl. Unlike the menu sprites it is
     downscaled rather than upscaled, so it needs no rendering hint. */
  .hero-art { object-fit: contain; }

  /* Country flag glyph. Sized up slightly against the code beside it,
     which always stays visible — see countryCell() in app.js. */
  .country-flag { font-size: 1.15em; line-height: 1; }
  /* Normal flow, left-aligned within the centered column — not absolutely
     positioned, so it reserves its own row instead of overlapping the
     label when a tile has no icon (e.g. an item/ability/move/team with no
     resolvable sprite). */
  .grid-6xn-tile .badge-rank { align-self: flex-start; }
  .grid-6xn-tile img { width: var(--icon-md); height: var(--icon-md); object-fit: contain; }
  .grid-6xn-tile .grid-6xn-label { font-weight: 600; font-size: var(--font-xs); overflow-wrap: anywhere; }
  .grid-6xn-value { font-weight: 800; font-size: var(--font-lg); color: var(--navy); }
  .grid-6xn-tile.is-leader .grid-6xn-value { color: var(--accent-red); }
  .grid-6xn-sub { font-size: var(--font-xs); color: var(--muted); }

  /* --- Pro Team Gallery card grid --- */
  .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: var(--space-4); }
  .gallery-card { border: 2px solid var(--border); border-radius: var(--radius-md); overflow: hidden; display: flex; flex-direction: column; }
  .gallery-card img.gallery-card-image { width: 100%; display: block; }
  .gallery-card .gallery-card-body { padding: var(--space-4); display: flex; flex-direction: column; gap: var(--space-1); }
  .gallery-card .gallery-card-player { font-weight: 700; }
  .gallery-card .gallery-card-meta { font-size: var(--font-xs); color: var(--muted); }

  .empty-state {
    background: var(--light-blue);
    border-radius: 8px;
    padding: 14px;
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* --- Badge (rank pills, speed tiers — see docs/design-system.md) --- */
  .badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    font-size: var(--font-xs);
    font-weight: 600;
    white-space: nowrap;
  }
  .badge-rank { background: var(--light-blue); color: var(--blue); }
  .badge-speed-blazing { background: var(--speed-blazing-bg); color: var(--speed-blazing); }
  .badge-speed-fast { background: var(--speed-fast-bg); color: var(--speed-fast); }
  .badge-speed-average { background: var(--speed-average-bg); color: var(--speed-average); }
  .badge-speed-slow { background: var(--speed-slow-bg); color: var(--speed-slow); }
  .badge-positive { background: var(--positive-bg); color: var(--positive); }
  .badge-negative { background: var(--danger-bg); color: var(--danger); }

  /* Data & Sources tab. Table cells there hold prose and endpoint URLs
     rather than the short numeric values every other table has, so they
     opt into wrapping instead of forcing the row wider. */
  .wrap-cell { white-space: normal; min-width: 220px; max-width: 420px; }
  .wrap-cell code { font-size: var(--font-xs); word-break: break-all; }
  .caveat-list {
    margin: 0;
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    color: var(--muted);
  }
  .caveat-list strong { color: var(--navy); }
  .badge-new { background: var(--accent-gold-bg); color: var(--warning); }

  /* --- Type badge (Pokémon Profile header, Matchup tab pickers) — the
     dashboard's first-ever Pokémon-type display (pokemon.type_1/type_2,
     PokéAPI). Icon-only emblems (no visible text label) — the type name
     is exposed via the pill's aria-label/the icon's title attribute
     instead, so it stays accessible without cluttering the badge. Uses
     --icon-xl for hero-level prominence, the one documented exception to
     the 3-tier icon scale. --- */
  .type-badge-row { display: flex; align-items: center; gap: var(--space-2); }
  .type-pill { display: inline-flex; align-items: center; justify-content: center; }

  /* Profile header's dual-type display — the one place a type icon uses
     --icon-xl instead of the sm/md/lg scale (see "Icon size scale" above). */
  .type-badge-row.type-badge-lg { gap: var(--space-3); margin: var(--space-2) 0; }
  /* A labelled pill tinted with the type's own color: an icon plus the
     type name reads faster than a bare emblem, and stays smaller than the
     Pokémon's art beside it (see renderTypeBadgeRow in app.js). */
  .type-badge-lg .type-pill-lg {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border-radius: 999px;
    padding: 4px 12px 4px 6px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: capitalize;
    color: #fff;
    background: var(--pill-type-color, var(--type-unknown));
  }

  /* static/icons/types/*.png are square, text-free round emblems, so a
     type icon is just an <img> at the requested size (typeIconImg() in
     app.js). */
  .type-icon { display: inline-block; vertical-align: middle; object-fit: contain; flex: 0 0 auto; }

  /* --- Descriptive sub-text under a name (Pokémon Profile's Items/
     Ability/Moves sections; Matchup panel move picker) --- */
  .desc-text { font-size: var(--font-xs); color: var(--muted); margin-top: 2px; }

  /* --- Matchup tab: type-effectiveness grid + damage calculator --- */
  .type-effect-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); gap: var(--space-2); }
  .type-effect-tile {
    border-radius: var(--radius-sm);
    padding: var(--space-2);
    text-align: center;
    font-size: var(--font-xs);
    font-weight: 700;
    text-transform: uppercase;
  }
  .type-effect-4x { background: #1f8a4c; color: #fff; }
  .type-effect-2x { background: #bfe3cd; color: #1f8a4c; }
  .type-effect-1x { background: var(--light-blue); color: var(--muted); }
  .type-effect-half { background: #fbe3c9; color: var(--warning); }
  .type-effect-quarter { background: var(--danger-bg); color: var(--danger); }
  .type-effect-0x { background: var(--navy); color: #fff; }

  .matchup-picker-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }
  .matchup-side { border: 1px solid var(--light-blue); border-radius: var(--radius-md); padding: var(--space-4); }
  .matchup-side h4 { margin: 0 0 var(--space-2); }
  .stage-row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); margin-bottom: var(--space-1); }
  .stage-row label { font-size: var(--font-xs); color: var(--muted); flex: 0 0 60px; }
  .stage-row input[type="range"] { flex: 1 1 auto; }
  .stage-row .stage-value { width: 2.2em; text-align: right; font-weight: 700; font-size: var(--font-xs); }

  .damage-result { background: var(--light-blue); border-radius: var(--radius-md); padding: var(--space-4); margin-top: var(--space-4); text-align: center; }
  .damage-result .damage-range { font-size: var(--font-2xl); font-weight: 800; color: var(--navy); }
  .damage-result .damage-sub { font-size: var(--font-sm); color: var(--muted); margin-top: var(--space-1); }
  .toggle-chip-row { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-2); }
  .toggle-chip {
    font-size: var(--font-xs);
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    background: var(--surface);
    cursor: pointer;
  }
  .toggle-chip[aria-pressed="true"] { background: var(--blue); border-color: var(--blue); color: #fff; }

  /* Type filter (Usage, Pokémon Profile, Team Builder): one bare type icon
     per button, no pill and no text. A picked type gets a ring in the
     navy accent; once anything is picked, the unpicked icons fade back so
     the active filter reads at a glance. */
  .type-filter-chip {
    display: inline-flex;
    padding: 2px;
    border: 2px solid transparent;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    transition: transform 0.12s ease, opacity 0.12s ease, border-color 0.12s ease;
  }
  .type-filter-chip:hover { transform: scale(1.12); }
  .type-filter-chip:focus-visible { outline: 2px solid var(--blue); outline-offset: 1px; }
  .type-filter-chip[aria-pressed="true"] { border-color: var(--navy); transform: scale(1.08); }
  .type-filter-row.has-selection .type-filter-chip[aria-pressed="false"] { opacity: 0.35; }
  .type-filter-row.has-selection .type-filter-chip[aria-pressed="false"]:hover { opacity: 0.8; }

  /* --- Top Teams tab: leaderboard tiles + pokepaste import/export --- */
  .pokepaste-box { display: flex; flex-direction: column; gap: var(--space-2); margin-bottom: var(--space-4); }
  .pokepaste-box textarea {
    width: 100%;
    min-height: 140px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: var(--font-sm);
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    resize: vertical;
  }
  .pokepaste-actions { display: flex; gap: var(--space-2); align-items: center; }
  .pokepaste-status { font-size: var(--font-xs); color: var(--muted); }

  /* --- Buttons --- */
  .btn {
    font: inherit;
    font-size: var(--font-sm);
    font-weight: 600;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--navy);
    cursor: pointer;
  }
  .btn:hover { background: var(--light-blue); }
  .btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .btn-primary { background: var(--blue); color: #fff; border-color: var(--blue); }
  .btn-primary:hover { background: var(--navy); }
  .btn-primary:disabled { background: var(--muted); border-color: var(--muted); }
  .btn-remove {
    background: none;
    border: none;
    color: var(--danger);
    font-size: var(--font-md);
    cursor: pointer;
    line-height: 1;
    padding: 2px 6px;
  }
  .btn-remove:hover { text-decoration: underline; }
  .btn-sm { padding: 4px 10px; font-size: var(--font-xs); }

  input[type="text"] {
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    font-size: 16px; /* prevents iOS Safari auto-zoom-on-focus */
    width: 100%;
  }

  /* --- Team Builder --- */
  .team-builder-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }
  .roster-picker { display: flex; flex-direction: column; gap: var(--space-3); }
  .roster-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 420px;
    overflow-y: auto;
    border: 1px solid var(--light-blue);
    border-radius: var(--radius-sm);
  }
  .roster-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-bottom: 1px solid var(--light-blue);
  }
  .roster-item:last-child { border-bottom: none; }
  .roster-item .roster-info { flex: 1 1 auto; min-width: 0; }
  .roster-item .roster-name { font-weight: 600; }
  .roster-item .roster-sub { font-size: var(--font-xs); color: var(--muted); }

  .team-slots {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }
  .team-slot {
    border: 2px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    text-align: center;
    min-height: 96px;
    justify-content: center;
  }
  .team-slot.empty { border-style: dashed; color: var(--muted); font-size: var(--font-xs); }
  .team-slot img { width: var(--icon-lg); height: var(--icon-lg); object-fit: contain; }
  .team-slot .slot-name { font-weight: 600; font-size: var(--font-sm); }
  .team-slot .slot-detail { font-size: var(--font-xs); color: var(--muted); }
  .team-slot select { width: 100%; margin-top: 2px; }
  .team-slot .slot-move-selects { display: flex; flex-direction: column; gap: 2px; width: 100%; }

  .speed-order-list { list-style: none; margin: 0; padding: 0; }
  .speed-order-list li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) 0;
  }
  .speed-order-list .speed-value { margin-left: auto; font-weight: 600; }

  .stat-summary-row {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }
  .stat-summary-row .stat {
    background: var(--light-blue);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    font-size: var(--font-sm);
  }
  .stat-summary-row .stat strong { display: block; font-size: var(--font-lg); color: var(--navy); }

  /* --- Team Analyst --- */
  .team-analysis { margin-top: var(--space-6); border-top: 2px solid var(--light-blue); padding-top: var(--space-4); }
  .team-analysis h3 { margin-top: 0; }
  .team-analysis h4 { margin-bottom: var(--space-2); }
  .team-analysis-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-3); }
  .analysis-card { background: var(--light-blue); border-radius: var(--radius-md); padding: var(--space-3); }
  .analysis-card strong { display: block; color: var(--navy); font-size: var(--font-lg); }
  .analysis-card span { color: var(--muted); font-size: var(--font-xs); }
  .team-analysis-columns { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); margin-top: var(--space-5); }
  .team-analysis table { font-size: var(--font-sm); }
  .team-analysis .status-good { color: var(--positive); font-weight: 700; }
  .team-analysis .status-warn { color: var(--warning); font-weight: 700; }

  @media (max-width: 720px) {
    .tabs { flex-wrap: nowrap; }
    /* Bottom navigation: the five sections stay one thumb-reach away. */
    .sections {
      position: fixed;
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      justify-content: space-around;
      margin: 0;
      padding: 6px 4px calc(6px + env(safe-area-inset-bottom));
      background: var(--panel-dark);
      box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.2);
    }
    .section-btn { flex: 1 1 0; min-height: 44px; padding: 8px 4px; font-size: 0.85rem; background: transparent; border: none; color: #b8bdd1; border-radius: var(--radius-sm); }
    .section-btn[aria-current="true"] { color: #fff; background: rgba(255, 255, 255, 0.12); }
    body { padding-bottom: 64px; }
    .team-builder-grid { grid-template-columns: 1fr; }
    .team-slots { grid-template-columns: repeat(2, 1fr); }
    .team-analysis-grid, .team-analysis-columns { grid-template-columns: 1fr; }
    .grid-6xn { grid-template-columns: repeat(3, 1fr); }
    .matchup-picker-grid { grid-template-columns: 1fr; }
  }


  .compare-columns { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16px; margin:16px 0; }
  .compare-card, .expansion-card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-md); padding:16px; }
  .compare-card h3, .expansion-card h3 { margin-top:0; }
  .expansion-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }
  .link-button { border:0; background:none; color:var(--blue); padding:0; cursor:pointer; text-decoration:underline; }
  .source-note { color:var(--muted); font-size:var(--font-sm); }
  @media (max-width:720px) { .compare-columns, .expansion-grid { grid-template-columns:1fr; } }
  .site-footer { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 14px; color: var(--muted); font-size: 0.8rem; padding: 24px; }
  .site-footer span + span::before { content: none; }

  @media (max-width: 720px) {
    main { padding: var(--space-3) 16px 16px; }
    .tabs { padding: 0 16px; }
    .kpi-row { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); margin-bottom: var(--space-3); }
    .kpi-card { padding: 6px 10px; }
  }

  @media (max-width: 480px) {
    .controls select { width: 100%; }
    section { padding: var(--space-4); }
    section h2 { margin: 0 calc(var(--space-4) * -1) var(--space-4); padding: var(--space-3) var(--space-4); }
    .grid-6xn { grid-template-columns: repeat(2, 1fr); }
  }
</style>
</head>
<body>
{# One sticky 56px bar (docs/upgrade-plan-2027q1.md, U2): the brand, the
   five sections, the regulation select and a ⋯ menu. The dataset version,
   snapshot and gate status moved to the footer and the Data section, so
   content starts within 200px of the top. On phones the section buttons
   become a bottom navigation bar (the .sections rules in the max-width
   720px block). #}
<header class="topbar">
  <a class="brand" href="#/overview" aria-label="Pokémon Champions data: home">Champions<span class="brand-sub"> Data</span></a>
  <nav class="sections" aria-label="Sections">
    <button type="button" class="section-btn" data-section="meta" aria-current="true">Meta</button>
    <button type="button" class="section-btn" data-section="pokemon">Pokémon</button>
    <button type="button" class="section-btn" data-section="teams">Teams</button>
    <button type="button" class="section-btn" data-section="builder">Builder</button>
    <button type="button" class="section-btn" data-section="data">Data</button>
  </nav>
  <div class="topbar-actions">
    {% if payload.kpis_by_scope %}
      {# Which regulation every figure on the page describes. static/app.js
         sets the selected option from ?reg= and reloads on change. #}
      <label class="regulation-picker"><span class="visually-hidden">Regulation</span>
        <select id="regulation-scope" aria-label="Regulation shown on this page">
          {% for scope in payload.kpis_by_scope %}
            {% set reg = payload.regulations | selectattr("regulation_code", "equalto", scope) | first %}
            <option value="{{ scope }}"{% if scope == payload.default_scope %} selected{% endif %}>
              {%- if reg %}Reg {{ scope | upper }}{% else %}All regulations{% endif -%}
            </option>
          {% endfor %}
        </select>
      </label>
    {% endif %}
    <div class="more-menu">
      <button type="button" class="more-menu-btn" id="more-menu-btn" aria-haspopup="true" aria-expanded="false" aria-controls="more-menu-panel" aria-label="More options">&#8943;</button>
      <div class="more-menu-panel" id="more-menu-panel" hidden>
        <button type="button" class="theme-toggle" id="theme-toggle">Theme: Auto</button>
        <a href="#/data/how-to-read">How to read this page</a>
        <a href="#/data">Data &amp; sources</a>
      </div>
    </div>
  </div>
</header>
{# Filled in by static/app.js (renderStalenessBanner) when the newest
   tournament is over three weeks old, or when no tournament in the data
   was played under the regulation in force today. #}
<div id="staleness-banner" class="staleness-banner" role="status" hidden></div>
{# Filled in by static/app.js (renderRolloverBanner) during the first weeks
   of a new regulation, when the page opens on the previous one
   (docs/upgrade-plan-2027q1.md, U3). #}
<div id="rollover-banner" class="staleness-banner rollover-banner" role="status" hidden></div>
<nav class="tabs" role="tablist" aria-label="Views in this section">
  <button class="tab-btn" role="tab" data-section="meta" data-tab="overview" aria-selected="true">Overview</button>
  <button class="tab-btn" role="tab" data-section="meta" data-tab="tiers" aria-selected="false">Tier List</button>
  <button class="tab-btn" role="tab" data-section="meta" data-tab="usage" aria-selected="false">Usage</button>
  <button class="tab-btn" role="tab" data-section="meta" data-tab="speed-tiers" aria-selected="false">Speed Tiers</button>
  <button class="tab-btn" role="tab" data-section="pokemon" data-tab="pokemon-profile" aria-selected="false">Profile</button>
  <button class="tab-btn" role="tab" data-section="pokemon" data-tab="compare" aria-selected="false">Compare</button>
  <button class="tab-btn" role="tab" data-section="pokemon" data-tab="matchup" aria-selected="false">Matchup</button>
  <button class="tab-btn" role="tab" data-section="teams" data-tab="top-teams" aria-selected="false">Top Teams</button>
  <button class="tab-btn" role="tab" data-section="teams" data-tab="events" aria-selected="false">Events</button>
  <button class="tab-btn" role="tab" data-section="teams" data-tab="archetypes" aria-selected="false">Archetypes</button>
  <button class="tab-btn" role="tab" data-section="teams" data-tab="core-explorer" aria-selected="false">Core Explorer</button>
  <button class="tab-btn" role="tab" data-section="teams" data-tab="players" aria-selected="false">Players</button>
  <button class="tab-btn" role="tab" data-section="builder" data-tab="team-builder" aria-selected="false">Team Builder</button>
  <button class="tab-btn" role="tab" data-section="data" data-tab="data-sources" aria-selected="false">Data &amp; Sources</button>
</nav>
<main>
  <div id="kpi-strip">
  {# One KPI row per regulation scope; app.js shows the selected one. The
     whole strip shows on the Meta section only. #}
  {% for scope, scope_kpis in (payload.kpis_by_scope or {"all": payload.kpis}).items() %}
  <div class="kpi-row" data-scope="{{ scope }}"{% if scope != (payload.default_scope or "all") %} hidden{% endif %}>
    <div class="kpi-card">
      <div class="kpi-body">
        <div class="label">Sample</div>
        <div class="value">{{ scope_kpis.event_count or 0 }} event{% if scope_kpis.event_count != 1 %}s{% endif %} · {{ "{:,}".format(scope_kpis.team_count or 0) }} teams</div>
        {% if scope_kpis.latest_event %}
          <div class="sub">Latest: <a href="#/event/{{ scope_kpis.latest_event.event_id }}" title="{{ scope_kpis.latest_event.event_name }}">{{ scope_kpis.latest_event.short_name }}</a>, {{ scope_kpis.latest_event.event_date }}</div>
        {% endif %}
      </div>
    </div>
    <div class="kpi-card">
      {% set top_used = scope_kpis.top_used_pokemon %}
      {% set top_used_art = payload.sprites.get(top_used.pokemon_key) if top_used %}
      {% if top_used_art %}
        <img class="kpi-sprite" src="{{ top_used_art }}" alt="" width="48" height="48" decoding="async">
      {% endif %}
      <div class="kpi-body">
        <div class="label">Most used</div>
        <div class="value">{% if top_used %}<a href="#/pokemon/{{ top_used.pokemon_key }}">{{ top_used.pokemon_name }}</a>{% else %}—{% endif %}</div>
        <div class="sub">{% if top_used %}{% if top_used.usage_share is not none %}{{ "%.1f"|format(top_used.usage_share * 100) }}% of roster slots · {% endif %}{{ "{:,}".format(top_used.usage_count) }} teams{% endif %}</div>
      </div>
    </div>
    <div class="kpi-card">
      {% set top_win = scope_kpis.top_win_rate_pokemon %}
      {% set top_win_art = payload.sprites.get(top_win.pokemon_key) if top_win %}
      {% if top_win_art %}
        <img class="kpi-sprite" src="{{ top_win_art }}" alt="" width="48" height="48" decoding="async">
      {% endif %}
      <div class="kpi-body">
        <div class="label">Top win rate</div>
        <div class="value">{% if top_win %}<a href="#/pokemon/{{ top_win.pokemon_key }}">{{ top_win.pokemon_name }}</a>{% else %}—{% endif %}</div>
        <div class="sub">{% if top_win %}{{ "%.1f"|format(top_win.win_rate * 100) }}% across {{ "{:,}".format(top_win.record_count) }} teams{% endif %}</div>
      </div>
    </div>
    <div class="kpi-card">
      {% set current_reg = scope_kpis.current_regulation %}
      <div class="kpi-body">
        <div class="label">Legal pool{% if current_reg %} · {{ current_reg.regulation_code | upper }}{% endif %}</div>
        <div class="value">{% if current_reg and current_reg.legal_pokemon_count is not none %}{{ current_reg.legal_pokemon_count }} Pokémon{% else %}—{% endif %}</div>
        <div class="sub">{% if current_reg %}{{ current_reg.start_date }} to {{ current_reg.end_date }}{% endif %}</div>
      </div>
    </div>
  </div>
  {% endfor %}
  </div>

  <section class="tab-panel" data-panel="overview" data-section="meta">
    <h2 class="panel-title">Overview</h2>
    <section class="movers-panel" id="movers-panel" hidden></section>
    <div class="overview-row" id="overview-row" hidden>
      <div id="overview-latest-event"></div>
      <div id="overview-starters"></div>
    </div>
    <h3>Most used</h3>
    <p class="lead" id="overview-sub">Top 12 most-used Pokémon, ranked by share of roster slots.</p>
    <div class="grid-6xn" id="overview-top-12"></div>
  </section>

  <section class="tab-panel" data-panel="tiers" data-section="meta" hidden>
    <h2 class="panel-title">Tier List</h2>
    <p class="lead">Bands by share of roster slots; the chip beside each Pokémon is its win rate.</p>
    <details class="method"><summary>How this is computed</summary><p id="tiers-method"></p></details>
    <div id="tiers-body"></div>
  </section>

  <section class="tab-panel" data-panel="usage" data-section="meta" hidden>
    <h2 class="panel-title">Usage</h2>
    <p class="lead">How often each Pokémon is brought, and how its teams do, in Champions tournaments.</p>
    <details class="method"><summary>How this is computed</summary>
      <p>Every figure is computed from the team sheets of Champions-format tournaments only (MunchStats), never blended with standard VGC events. Usage is a Pokémon's share of all roster slots; a team contributes six.</p>
    </details>
    <div class="subtabs" role="tablist">
      <button class="subtab-btn" role="tab" data-subtab="usage-leaders" data-route="leaders" aria-selected="true">Usage</button>
      <button class="subtab-btn" role="tab" data-subtab="win-rate-leaders" data-route="win-rate" aria-selected="false">Win rate</button>
      <button class="subtab-btn" role="tab" data-subtab="usage-success" data-route="success" aria-selected="false">Success</button>
      <button class="subtab-btn" role="tab" data-subtab="usage-trends" data-route="trends" aria-selected="false">Trends</button>
    </div>

    <div class="subtab-panel" data-subpanel="usage-leaders">
      <div class="controls">
        <label>Tier
          <select id="usage-tier-filter"></select>
        </label>
        <div class="filter-field"><span class="filter-label">Type</span>
          <div class="type-filter-row" id="usage-type-filter"></div>
        </div>
        <label>Role
          <select id="usage-role-filter">
            <option value="">All roles</option>
            <option value="physical">Physical</option>
            <option value="special">Special</option>
            <option value="mixed">Mixed</option>
          </select>
        </label>
        <label>Usage %
          <div class="range-filter">
            <input type="number" id="usage-share-min" min="0" max="100" placeholder="min" aria-label="Minimum usage %">
            <span>–</span>
            <input type="number" id="usage-share-max" min="0" max="100" placeholder="max" aria-label="Maximum usage %">
          </div>
        </label>
        <label>Speed
          <div class="range-filter">
            <input type="number" id="usage-speed-min" min="0" placeholder="min" aria-label="Minimum base Speed">
            <span>–</span>
            <input type="number" id="usage-speed-max" min="0" placeholder="max" aria-label="Maximum base Speed">
          </div>
        </label>
      </div>
      <p class="sub" id="usage-table-note"></p>
      <div id="usage-table"></div>
    </div>

    <div class="subtab-panel" data-subpanel="win-rate-leaders" hidden>
      <p class="lead">Ranked by the 95% Wilson lower bound, so a small sample can't top the list on luck.</p>
      <div class="controls">
        <label>Min. teams
          <select id="win-rate-min-record-count-filter">
            <option value="5">5+</option>
            <option value="10">10+</option>
            <option value="20" selected>20+</option>
            <option value="50">50+</option>
          </select>
        </label>
      </div>
      <div id="win-rate-table"></div>
    </div>

    <div class="subtab-panel" data-subpanel="usage-success" hidden>
      <p class="lead">Popular is not the same as successful: usage weighted by where each team finished.</p>
      <details class="method"><summary>How this is computed</summary>
        <p>Raw usage counts a last-place team's roster slot exactly like a winner's. <strong>Top cut</strong> counts only appearances on a team that placed 1&#8211;8; <strong>placement-weighted</strong> weights every appearance by 1/placement, so a win counts far more than a 200th with no cutoff cliff.</p>
        <p>The <strong>Movement</strong> column is how many places a Pokémon gains or loses versus its raw usage rank. A positive number is a quiet top-cut staple; a negative one is a crowd favourite that underperforms.</p>
      </details>
      <div class="controls">
        <label>Ranked by
          <select id="usage-success-metric">
            <option value="placement_weighted">Placement-weighted</option>
